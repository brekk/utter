import type { Vizier } from "vizier"
import type { Cluster } from "vizier/Cluster"
import type { Edge, EdgeAttribute } from "vizier/Edge"
import type { Graph, GraphAttribute } from "vizier/Graph"
import type { Node, NodeAttribute } from "vizier/Node"

import type { Machine } from "@/Machine"

import Dict from "Dictionary"
import List from "List"
import Set from "Set"

import { Vizier, toString } from "vizier"
import VCluster from "vizier/Cluster"
import VColor from "vizier/Color"
import VEdge from "vizier/Edge"
import VGraph from "vizier/Graph"
import VNode from "vizier/Node"

import Log from "@/Log"
import M from "@/Machine"



alias GraphvizConfig = {
  attrStyle :: List GraphAttribute,
  clusters :: List Cluster,
  edgeStyle :: List EdgeAttribute,
  edges :: List Edge,
  graphs :: List Graph,
  nodeMap :: String -> List NodeAttribute,
  nodeStyle :: List NodeAttribute,
  nodes :: List Node,
}
graphAttrs = ({ fontname }) => [VGraph.Fontname(fontname)]
toGraphviz :: GraphvizConfig -> Machine pay ctx -> Vizier
export toGraphviz = (conf, mch) => where(mch) {
  M.Machine(_name, _states, _curr) =>
    do {
      {
        nodeMap,
        nodes: givenNodes,
        clusters: givenClusters,
        edges: givenEdges,
        graphs: givenGraphs,
      } = conf
      nodeList = pipe(
        M.states,
        Set.toList,
      )(mch)
      nodes = pipe(
        map((v) => VNode.Node(v, nodeMap(v))),
      )(nodeList)
      edges = pipe(
        M.eventMap,
        Dict.toList,
        chain(
          (#[start, vv]) => pipe(
            Dict.toList,
            map(
              (#[label, end]) => VEdge.Edge([start, end], [...conf.edgeStyle, VEdge.Label(label)]),
            ),
          )(vv),
        ),
      )(mch)
      // GCNE
      // graphs clusters nodes edges
      return Vizier(
        _name,
        [...conf.attrStyle],
        [...givenGraphs],
        [...givenClusters],
        [...givenNodes, ...nodes],
        [...givenEdges, ...edges],
      )
    }
}
VANILLA :: GraphvizConfig
export VANILLA = {
  nodeMap: (_) => [],
  clusters: [],
  attrStyle: [],
  edgeStyle: [],
  nodeStyle: [],
  nodes: [],
  graphs: [],
  edges: [],
}
toDotWithConfig :: GraphvizConfig -> Machine pay ctx -> String
export toDotWithConfig = (conf, mch) => pipe(
  toGraphviz(conf),
  toString,
)(mch)
export defaultConfig = (a) => {
  attrStyle = graphAttrs(a)
  return { ...VANILLA, edges: [VEdge.GlobalEdge([VEdge.Fontname(a.fontname)])], attrStyle }
}
export toDot = toDotWithConfig(
  defaultConfig({ fontname: `"Helvetica Neue",Helvetica,Arial,sans-serif` }),
)
