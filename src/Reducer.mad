import type { Maybe } from "Maybe"

import type { TransitionModifier } from "@/Utter"

import Id from "@/Identifier"
import Mod from "@/TransitionModifier"
import { Reducer } from "@/Utter"



keygen = Id.create("reducer")
export create = Reducer(keygen())
reduce :: (Show pay, Show ctx) => String
  -> pay
  -> Maybe ctx
  -> TransitionModifier pay ctx
  -> Maybe ctx
export reduce = (ev, pay, ctx, act) => pipe(
  Mod.ensureReducer,
  where {
    Reducer(_, call) =>
      call(ev, pay, ctx)

    _ =>
      ctx
  },
)(act)
export herald = (binaryLogger, k, x) => pipe(
  Mod.ensureReducer,
  where {
    Reducer(_id, fn) =>
      Reducer(
        _id,
        pipe(
          fn,
          binaryLogger(_id ++ ":" ++ k),
        ),
      )

    _ =>
      x
  },
)(x)
