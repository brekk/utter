import type { Maybe } from "Maybe"

import type { TransitionModifier } from "@/Utter"

import List from "List"
import { Just } from "Maybe"

import _List from "@/List"
import Mod from "@/Modifier"
import { Reducer } from "@/Utter"



export create = Reducer
reduce :: (Show pay, Show ctx) => String
  -> pay
  -> Maybe ctx
  -> TransitionModifier pay ctx
  -> Maybe ctx
export reduce = (ev, pay, ctx, act) => pipe(
  Mod.ensureReducer,
  where {
    Reducer(call) =>
      call(ev, pay, ctx)

    _ =>
      ctx
  },
)(act)

