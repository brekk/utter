import type { Maybe } from "Maybe"

import type { TransitionModifier } from "@/Utter"

import Id from "@/Identifier"
import Mod from "@/TransitionModifier"
import { Action, PostAction } from "@/Utter"



keygen = Id.create("action")
export createRawAction = Action
export create = Action(keygen())
export createPost = PostAction(keygen())
invoke :: (Show pay, Show ctx) => String -> pay -> Maybe ctx -> TransitionModifier pay ctx -> {}
export invoke = (ev, pay, ctx, act) => pipe(
  Mod.ensureAction,
  where {
    Action(_, call) =>
      call(ev, pay, ctx)

    PostAction(_, call) =>
      call(ev, pay, ctx)

    _ =>
      {}
  },
)(act)
export herald = (binaryLogger, k, x) => pipe(
  Mod.ensureAction,
  where {
    Action(_id, fn) =>
      Action(
        _id,
        pipe(
          binaryLogger(_id ++ ":" ++ k),
          fn,
        ),
      )

    PostAction(_id, fn) =>
      PostAction(
        _id,
        pipe(
          binaryLogger(_id ++ ":" ++ k),
          fn,
        ),
      )

    _ =>
      x
  },
)(x)
