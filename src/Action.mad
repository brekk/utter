import type { Maybe } from "Maybe"

import type { TraitModifier, TransitionModifier } from "@/Utter"

import List from "List"
import { Just, Nothing, isJust } from "Maybe"

import _List from "@/List"
import Mod from "@/Modifier"
import { Action, Named, PostAction, TraitModifier, TraitsModifier } from "@/Utter"



export create = Action
export createPost = PostAction
invoke :: (Show pay, Show ctx) => String -> pay -> Maybe ctx -> TransitionModifier pay ctx -> {}
export invoke = (ev, pay, ctx, act) => pipe(
  Mod.ensureAction,
  where {
    Action(call) =>
      call(ev, pay, ctx)

    PostAction(call) =>
      call(ev, pay, ctx)

    _ =>
      {}
  },
)(act)
export herald = (binaryLogger, k, x) => pipe(
  where {
    TraitModifier(Named(_id), Action(fn)) =>
      TraitModifier(
        Named(_id),
        Action(
          pipe(
            binaryLogger(_id ++ ":" ++ k),
            fn,
          ),
        ),
      )

    TraitsModifier(lx, Action(fn)) =>
      do {
        updated = if (_List.some(Mod.hasTraitNamed, lx)) {
          where(List.find(Mod.hasTraitNamed, lx) ?? Named("UnnamedAction")) {
            Named(_id) =>
              Action(
                pipe(
                  binaryLogger(_id ++ ":" ++ k),
                  fn,
                ),
              )
          }
        } else {
          Action(fn)
        }

        return TraitsModifier(lx, updated)
      }

    TraitModifier(Named(_id), PostAction(fn)) =>
      TraitModifier(
        Named(_id),
        PostAction(
          pipe(
            binaryLogger(_id ++ ":" ++ k),
            fn,
          ),
        ),
      )

    TraitsModifier(lx, PostAction(fn)) =>
      do {
        updated = if (_List.some(Mod.hasTraitNamed, lx)) {
          where(List.find(Mod.hasTraitNamed, lx) ?? Named("UnnamedPostAction")) {
            Named(_id) =>
              PostAction(
                pipe(
                  binaryLogger(_id ++ ":" ++ k),
                  fn,
                ),
              )
          }
        } else {
          PostAction(fn)
        }

        return TraitsModifier(lx, updated)
      }

    _ =>
      x
  },
)(x)
