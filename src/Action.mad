import type { Maybe } from "Maybe"

import type { TransitionModifier } from "@/Types"

import { Action, PostAction } from "@/Types"



invoke :: String -> pay -> Maybe ctx -> TransitionModifier pay ctx -> {}
export invoke = (ev, pay, ctx, act) => where(act) {
  Action(call) =>
    call(ev, pay, ctx)

  PostAction(call) =>
    call(ev, pay, ctx)

  _ =>
    ???
}
