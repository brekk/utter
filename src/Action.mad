import type { Maybe } from "Maybe"

import type { Action, Controller } from "@/Types"

import Fn from "Function"

import { Action, PostAction } from "@/Types"



invoke :: String -> pay -> Maybe ctx -> Controller pay ctx -> Action pay ctx -> {}
export invoke = (ev, pay, ctx, ctrl, act) => where(act) {
  Action(call) =>
    call(ev, pay, ctrl, ctx)

  PostAction(call) =>
    call(ev, pay, ctrl, ctx)
}
isPostAction :: Action pay ctx -> Boolean
export isPostAction = where {
  PostAction(_) =>
    true

  _ =>
    false
}
export isAction = Fn.complement(isPostAction)
