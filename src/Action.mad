import type { Maybe } from "Maybe"

import type { TransitionModifier } from "@/Types"

import Mod from "@/TransitionModifier"
import { Action, PostAction } from "@/Types"



invoke :: (Show pay, Show ctx) => String -> pay -> Maybe ctx -> TransitionModifier pay ctx -> {}
export invoke = (ev, pay, ctx, act) => pipe(
  Mod.ensureAction,
  where {
    Action(call) =>
      call(ev, pay, ctx)

    PostAction(call) =>
      call(ev, pay, ctx)

    _ =>
      ???
  },
)(act)
