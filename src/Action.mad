import type { Maybe } from "Maybe"

import type { Action } from "@/Types"

import Fn from "Function"

import { Action, PostAction } from "@/Types"



invoke :: String -> pay -> Maybe ctx -> Action pay ctx -> {}
export invoke = (ev, pay, ctx, act) => where(act) {
  Action(call) =>
    call(ev, pay, ctx)

  PostAction(call) =>
    call(ev, pay, ctx)
}
isPostAction :: Action pay ctx -> Boolean
export isPostAction = where {
  PostAction(_) =>
    true

  _ =>
    false
}
export isAction = Fn.complement(isPostAction)
