import type { Transition } from "@/Transition"

import List from "List"
import String from "String"



export type State a = State(String, List (Transition a))

export createFinal = State($, [])
export create = State

name :: State a -> String
export name = where {
  State(n, _) =>
    n
}

transitions :: State a -> List (Transition a)
export transitions = where {
  State(_, t) =>
    t
}
