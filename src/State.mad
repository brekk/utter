import type { CTransition, State } from "@/Types"

import Fn from "Function"
import List from "List"
import String from "String"

import { FinalState, State } from "@/Types"



createFinal :: String -> State pay ctx
export createFinal = FinalState
create :: String -> List (CTransition pay ctx) -> State pay ctx
export create = (n, t) => List.length(t) > 0 ? State(n, t) : FinalState(n)
isFinal :: State pay ctx -> Boolean
export isFinal = where {
  FinalState(_) =>
    true

  _ =>
    false
}
name :: State pay ctx -> String
export name = where {
  State(n, _) =>
    n

  FinalState(n) =>
    n
}
transitions :: State pay ctx -> List (CTransition pay ctx)
export transitions = where {
  State(_, t) =>
    t

  _ =>
    []
}
nameMatches :: String -> State pay ctx -> Boolean
export nameMatches = (x, s) => pipe(
  name,
  Fn.equals(x),
)(s)
toPair :: State pay ctx -> #[string, List (CTransition pay ctx)]
export toPair = where {
  State(n, t) =>
    #[n, t]

  FinalState(n) =>
    #[n, []]
}
