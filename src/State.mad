import type { Comparison } from "Compare"
import type { Maybe } from "Maybe"

import type { Transitions } from "@/Transition"

import { EQ, GT, LT } from "Compare"
import Dict from "Dictionary"
import List from "List"

import Transition from "@/Transition"



export type State payload context = State(String, Transitions payload context)

instance Comparable a => Comparable (State a b) {
  compare = compareStates
}

compareStates = (a, b) => where(#[a, b]) {
  #[State(a1, _), State(b1, _)] =>
    a1 < b1 ? LT : a1 == b1 ? EQ : GT
}


export id = where {
  State(i, _) =>
    i
}
export routes = where {
  State(_, t) =>
    t
}
// findRouteDestination :: String -> State String a -> Maybe a
export findRouteDestination = (n, r) => pipe(
  routes,
  List.find(Transition.hasEventName(n)),
  map(Transition.destination),
)(r)

export create = State

// final is a reserved word?
terminal :: String -> State String a
export terminal = create($, [])

toTuple :: State String a -> #[String, Transitions String a]
export toTuple = where {
  State(k, v) =>
    #[k, v]
}

statesToDict :: List (State String a) -> Dictionary String (Transitions String a)
export statesToDict = pipe(
  map(toTuple),
  Dict.fromList,
)

// technically "states plural from dictionary"
fromDict :: Dictionary String (Transitions String a) -> List (State String a)
export fromDict = pipe(
  Dict.toList,
  map(where { #[k, v] => State(k, v) }),
)
