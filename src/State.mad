import type { Transition } from "@/Transition"

import Fn from "Function"
import List from "List"
import String from "String"



// a = event payload
// b = machine context
export type State a b = State(String, List (Transition a b))

export createFinal = State($, [])
export create = State

name :: State a b -> String
export name = where {
  State(n, _) =>
    n
}

transitions :: State a b -> List (Transition a b)
export transitions = where {
  State(_, t) =>
    t
}

nameMatches :: String -> State String b -> Boolean
export nameMatches = (x, s) => pipe(
  name,
  Fn.equals(x),
)(s)
