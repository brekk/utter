import type { CTransition } from "@/Transition"

import Fn from "Function"
import List from "List"
import String from "String"



export type State pay ctx = State(String, List (CTransition pay ctx))
export createFinal = State($, [])
export create = State
name :: State pay ctx -> String
export name = where {
  State(n, _) =>
    n
}
transitions :: State pay ctx -> List (CTransition pay ctx)
export transitions = where {
  State(_, t) =>
    t
}
nameMatches :: String -> State pay ctx -> Boolean
export nameMatches = (x, s) => pipe(
  name,
  Fn.equals(x),
)(s)
toPair :: State pay ctx -> #[string, List (CTransition pay ctx)]
export toPair = where {
  State(n, t) =>
    #[n, t]
}
