import type { Event } from "@/Event"

import Fn from "Function"
import List from "List"

import Event from "@/Event"



export type Route payload = Route(Event String payload, String)
export alias Routes payload = List (Route payload)


// destination :: Route a -> a
export destination = where {
  Route(_, o) =>
    o
}

// event :: Route a -> Event a b
export event = where {
  Route(e, _) =>
    e
}

// name :: Route a -> a
export name = pipe(
  event,
  Event.name,
)

export hasEventName = (n, r) => pipe(
  name,
  Fn.equals(n),
)(r)
