import type { Maybe } from "Maybe"

import type { GuardianFn, TransitionModifier } from "@/Utter"

import Log from "@/Log"
import Modifier from "@/Modifier"
import { Guard } from "@/Utter"



export create = Guard
// we don't have to ensure only guards here, as we can always return true
check :: (Show pay, Show ctx) => String -> pay -> Maybe ctx -> TransitionModifier pay ctx -> Boolean
export check = (ev, pay, ctx, guard) => where(guard) {
  Guard(engarde) =>
    engarde(ev, pay, ctx)

  _ =>
    true
}
complement :: GuardianFn pay ctx -> String -> pay -> Maybe ctx -> Boolean
export complement = (fn, ev, mPay, mCtx) => !fn(ev, mPay, mCtx)
// we have to ensure
invert :: (Show pay, Show ctx) => TransitionModifier pay ctx -> TransitionModifier pay ctx
export invert = (x) => pipe(
  Modifier.ensureGuard,
  where {
    Guard(fn) =>
      Guard((ev, pay, mCtx) => !fn(ev, pay, mCtx))

    _ =>
      x
  },
)(x)

