import type { Maybe } from "Maybe"

import type { GuardianFn, TransitionModifier } from "@/Utter"
import type { Id } from "@/Utter"

// import Crypto from "@/Crypto"
import Random from "Random"

import Id from "@/Identifier"
import Log from "@/Log"
import Modifier from "@/TransitionModifier"
import { Guard } from "@/Utter"



keygen = Id.create("guard")
export createRaw = Guard
export create = Guard(keygen())
check :: (Show pay, Show ctx) => String -> pay -> Maybe ctx -> TransitionModifier pay ctx -> Boolean
export check = (ev, pay, ctx, guard) => pipe(
  Modifier.ensureGuard,
  where {
    Guard(_, engarde) =>
      engarde(ev, pay, ctx)

    _ =>
      ???
  },
)(guard)
complement :: GuardianFn pay ctx -> String -> pay -> Maybe ctx -> Boolean
export complement = (fn, ev, mPay, mCtx) => !fn(ev, mPay, mCtx)
// protect ya neck
invertWithId :: (Show pay, Show ctx) => Id
  -> TransitionModifier pay ctx
  -> TransitionModifier pay ctx
export invertWithId = (newId, x) => pipe(
  Modifier.ensureGuard,
  where {
    Guard(_, fn) =>
      Guard(newId, (ev, pay, mCtx) => !fn(ev, pay, mCtx))

    _ =>
      ???
  },
)(x)
export invert = (x) => invertWithId(keygen(), x)
export mapGuard = (and, guard) => pipe(
  Modifier.ensureGuard,
  where {
    Guard(id, fn) =>
      Guard(id, and(fn))

    _ =>
      ???
  },
)(guard)
export herald = (binaryLogger, k, guard) => pipe(
  Modifier.ensureGuard,
  where {
    Guard(id, fn) =>
      Guard(
        id,
        pipe(
          binaryLogger(id ++ ":" ++ k),
          fn,
        ),
      )

    _ =>
      ???
  },
)(guard)
