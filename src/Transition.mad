import type { Maybe } from "Maybe"

import type { Action } from "@/Action"
import type { Guard } from "@/Guard"

import IO from "IO"
import List from "List"
import { Just, Nothing, fromMaybe } from "Maybe"
import String from "String"

import { Action, invoke } from "@/Action"
import Event from "@/Event"
import { Guard } from "@/Guard"
import Log from "@/Log"



export alias TransitionModifier pay ctx = {
  actions :: List (Action pay ctx),
  guards :: List (Guard pay ctx),
}
// event(origin) -> destination
export type Transition pay ctx = Transition(Event, String, Maybe (TransitionModifier pay ctx))
// TODO: deal with payloads in the future
export createWithContext = (fromEventName, toDestination, mods) => pipe(
  Event.create,
  Transition($, toDestination, mods),
  Log.env.transition("created"),
)(fromEventName)
export create = createWithContext($, $, Nothing)
event :: Transition a b -> String
export event = where {
  Transition(e, _, _) =>
    e
}
target :: Transition a b -> String
export target = where {
  Transition(_, d, _) =>
    d
}
modifiers :: Transition a b -> Maybe (TransitionModifier a b)
export modifiers = where {
  Transition(_, _, m) =>
    m
}
actions :: Transition pay ctx -> List (Action pay ctx)
export actions = pipe(
  modifiers,
  map(.actions),
  fromMaybe([]),
)
guards :: Transition a b -> List (Guard a b)
export guards = pipe(
  modifiers,
  map(.guards),
  fromMaybe([]),
)
checkGuard :: String -> Maybe a -> Maybe b -> Transition a b -> Boolean
export checkGuard = (ev, pay, ctx, tr) => pipe(
  guards,
  List.reduce(
    (pass, g) => if (pass) {
      where(g) {
        Guard(engarde) =>
          engarde(ctx, ev, pay)
      }
    } else {
      false
    },
    true,
  ),
)(tr)
