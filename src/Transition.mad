import type { Maybe } from "Maybe"

import type { Action, ActionController, CTransition, Guard, Reducer, Transition } from "@/Types"

import IO from "IO"
import List from "List"
// import { Just, Nothing, fromMaybe } from "Maybe"
import String from "String"

import Guard from "@/Guard"
import Log from "@/Log"
import { ComplexTransition, Reducer, Transition } from "@/Types"



export create = Transition
export createComplex = (k, v, a, g, r, x) => ComplexTransition(create(k, v), a, g, r, x)
export makeComplex = ComplexTransition($, [], [], [], [])
// useful in testing, mostly shouldn't be used for realsies
export createBasic = createComplex($, $, [], [], [], [])
name :: CTransition pay ctx -> String
export name = pipe(
  transition,
  event,
)
export createWithContext = (fromEventName, toDestination, a, g, r, x) => pipe(
  createComplex($, toDestination, a, g, r, x),
  Log.tapped.transition("created", name),
)(fromEventName)
event :: Transition -> String
export event = where {
  Transition(e, _) =>
    e
}
target :: Transition -> String
export target = where {
  Transition(_, d) =>
    d
}
transition :: CTransition pay ctx -> Transition
export transition = where {
  ComplexTransition(t, _, _, _, _) =>
    t
}
focus :: CTransition pay ctx -> String
export focus = pipe(
  transition,
  target,
)
actions :: CTransition pay ctx -> List (Action pay ctx)
export actions = where {
  ComplexTransition(_, m, _, _, _) =>
    m
}
guards :: CTransition pay ctx -> List (Guard pay ctx)
export guards = where {
  ComplexTransition(_, _, g, _, _) =>
    g
}
reducers :: CTransition pay ctx -> List (Reducer pay ctx)
export reducers = where {
  ComplexTransition(_, _, _, r, _) =>
    r
}
controllers :: CTransition pay ctx -> List (ActionController pay ctx)
export controllers = where {
  ComplexTransition(_, _, _, _, c) =>
    c
}
checkGuard :: String -> pay -> Maybe ctx -> CTransition pay ctx -> Boolean
export checkGuard = (ev, pay, ctx, tr) => pipe(
  guards,
  List.reduce((passing, a) => passing && Guard.check(ev, pay, ctx, a), true),
)(tr)
checkMany :: String -> pay -> Maybe ctx -> List (CTransition pay ctx) -> Boolean
export checkMany = (ev, pay, ctx, trx) => List.reduce(
  (passing, a) => if (passing) do {
    checked = checkGuard(ev, pay, ctx, a)
    Log.env.guard("checking: " ++ ev, !checked)
    return checked
  } else {
    false
  },
  true,
  trx,
)
toPair :: Transition -> #[String, String]
export toPair = where {
  Transition(a, b) =>
    #[a, b]
}
toSimplePair :: CTransition pay ctx -> #[String, String]
export toSimplePair = pipe(
  transition,
  toPair,
)
