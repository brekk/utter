import type { Actions } from "@/Action"
import type { Event } from "@/Event"
import type { Guards } from "@/Guard"

import List from "List"

import Event from "@/Event"
import R from "@/Transition/Route"



export fromRoute = (r, guards, actions) => where(r) {
  R.Route(a, b) =>
    Transition(a, b, guards, actions)
}

// transitions are routes with context

export type Transition payload context
  = Transition(
    Event String payload,
    String,
    Guards String payload context,
    Actions String payload context,
  )


export alias Transitions a b = List (Transition a b)

event :: Transition String String -> Event String String
export event = where {
  Transition(e, _, _, _) =>
    e
}

destination :: Transition String a -> String
export destination = where {
  Transition(_, o, _, _) =>
    o
}

export create = Transition($, $, [], [])
