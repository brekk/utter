import type { Actions } from "@/Action"
import type { Event } from "@/Event"
import type { Guards } from "@/Guard"

import Fn from "Function"
import List from "List"

import Event from "@/Event"



// routes represent machine state without context
// transitions are routes with context
export type Transition payload context
  = Route(Event String payload, String)
  | Transition(
    Event String payload,
    String,
    Guards String payload context,
    Actions String payload context,
  )

export alias Transitions payload context = List (Transition payload context)

export routeToTransition = (guards, actions, r) => where(r) {
  Route(a, b) =>
    Transition(a, b, guards, actions)

  t =>
    t
}

export transitionToRoute = where {
  Transition(a, b, _, _) =>
    Route(a, b)

  r =>
    r
}


event :: Transition String String -> Event String String
export event = where {
  Transition(e, _, _, _) =>
    e

  Route(e, _) =>
    e
}

destination :: Transition String a -> String
export destination = where {
  Transition(_, o, _, _) =>
    o

  Route(_, o) =>
    o
}

// name :: Route a -> a
export name = pipe(
  event,
  Event.name,
)

export hasEventName = (n, r) => pipe(
  name,
  Fn.equals(n),
)(r)
