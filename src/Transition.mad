import type { Maybe } from "Maybe"

import type { Event } from "@/Event"

import List from "List"
import { Just, Nothing, fromMaybe } from "Maybe"
import String from "String"

import Event from "@/Event"
import { log } from "@/Log"



// b = context
// a = event
export type Guard pay ctx = Guard(Maybe ctx -> Event -> Maybe pay -> Boolean)

// guard :: (b -> Event a -> Boolean) -> Guard a b
// export guard = Guard

// we're defining these incompletely for now (as boolean lists),
// but all of these fields should be more complex lists
export alias TransitionModifier pay ctx = {
  actions :: List Boolean,
  guards :: List (Guard pay ctx),
  reducers :: List Boolean,
}

// event(origin) -> destination
export type Transition pay ctx = Transition(Event, String, Maybe (TransitionModifier pay ctx))

// TODO: deal with payloads in the future
export withContext = (fromEventName, toDestination, mods) => pipe(
  Event.create,
  Transition($, toDestination, mods),
)(fromEventName)

export create = withContext($, $, Nothing)

event :: Transition a b -> Event
export event = where {
  Transition(e, _, _) =>
    e
}
target :: Transition a b -> String
export target = where {
  Transition(_, d, _) =>
    d
}

modifiers :: Transition a b -> Maybe (TransitionModifier a b)
export modifiers = where {
  Transition(_, _, m) =>
    m
}
import IO from "IO"



// checkGuard :: Event -> Maybe a -> Maybe b -> Transition a b -> Boolean
export checkGuard = (ev, pay, ctx, tr) => pipe(
  modifiers,
  map(.guards),
  fromMaybe([]),
  List.reduce(
    (pass, g) => if (pass) {
      where(log.guard("HEY", g)) {
        Guard(engarde) =>
          log.guard("WHAT? " ++ show(pay), engarde(ctx, ev, pay))
      }
    } else {
      false
    },
    true,
  ),
)(tr)
