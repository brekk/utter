import type { Maybe } from "Maybe"

import type { Action } from "@/Action"
import type { Guard } from "@/Guard"
import type { ActionReducer } from "@/Reducer"

import IO from "IO"
import List from "List"
// import { Just, Nothing, fromMaybe } from "Maybe"
import String from "String"

import Guard from "@/Guard"
import Log from "@/Log"



// we had to segment these types
export type Transition = Transition(String, String)
// because previously the payload and context were being conflated with the event and target types somehow
export type CTransition pay ctx
  = ComplexTransition(
    Transition,
    List (Action pay ctx),
    List (Guard pay ctx),
    List (ActionReducer pay ctx),
  )
export create = Transition
export createComplex = (k, v, a, g, r) => ComplexTransition(create(k, v), a, g, r)
export makeComplex = ComplexTransition($, [], [], [])
// useful in testing, mostly shouldn't be used for realsies
export createBasic = createComplex($, $, [], [], [])
export createWithContext = (fromEventName, toDestination, a, g, r) => pipe(
  createComplex($, toDestination, a, g, r),
  Log.env.transition("created"),
)(fromEventName)
event :: Transition -> String
export event = where {
  Transition(e, _) =>
    e
}
target :: Transition -> String
export target = where {
  Transition(_, d) =>
    d
}
transition :: CTransition pay ctx -> Transition
export transition = where {
  ComplexTransition(t, _, _, _) =>
    t
}
name :: CTransition pay ctx -> String
export name = pipe(
  transition,
  event,
)
focus :: CTransition pay ctx -> String
export focus = pipe(
  transition,
  target,
)
actions :: CTransition pay ctx -> List (Action pay ctx)
export actions = where {
  ComplexTransition(_, m, _, _) =>
    m
}
guards :: CTransition pay ctx -> List (Guard pay ctx)
export guards = where {
  ComplexTransition(_, _, g, _) =>
    g
}
reducers :: CTransition pay ctx -> List (ActionReducer pay ctx)
export reducers = where {
  ComplexTransition(_, _, _, r) =>
    r
}
checkGuard :: String -> Maybe pay -> Maybe ctx -> CTransition pay ctx -> Boolean
export checkGuard = (ev, pay, ctx, tr) => pipe(
  guards,
  List.reduce((passing, a) => passing && Guard.check(ev, ctx, pay, a), true),
)(tr)
checkMany :: String -> Maybe pay -> Maybe ctx -> List (CTransition pay ctx) -> Boolean
export checkMany = (ev, pay, ctx, trx) => List.reduce(
  (passing, a) => passing && checkGuard(ev, ctx, pay, a),
  true,
  trx,
)
toPair :: Transition -> #[String, String]
export toPair = where {
  Transition(a, b) =>
    #[a, b]
}
toSimplePair :: CTransition pay ctx -> #[String, String]
export toSimplePair = pipe(
  transition,
  toPair,
)
