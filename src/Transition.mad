import type { Maybe } from "Maybe"

import type { Transition, TransitionModifier, TransitionPath } from "@/Utter"

import IO from "IO"
import List from "List"
import { Just, Nothing } from "Maybe"
// import { Just, Nothing, fromMaybe } from "Maybe"
import String from "String"

import Guard from "@/Guard"
import Log from "@/Log"
import Modifier from "@/TransitionModifier"
import { ImmediatePath, ImmediateTransition, Reducer, Transition, TransitionPath } from "@/Utter"



export createDirect = (k, v, m) => Transition(TransitionPath(k, v), m)
// useful in testing, mostly shouldn't be used for realsies
export createRaw = createDirect($, $, [])
export create = (fromEventName, toDestination, x) => pipe(
  createDirect(fromEventName, toDestination),
  Log.tapped.transition("created", name),
)(x)
export createImmediate = (a, d) => pipe(
  ImmediateTransition(ImmediatePath(a)),
  Log.tapped.transition("created immediate", name),
)(d)
isImmediate :: Transition pay ctx -> Boolean
export isImmediate = where {
  ImmediateTransition(_, _) =>
    true

  _ =>
    false
}
isNormal :: Transition pay ctx -> Boolean
export isNormal = where {
  ImmediateTransition(_, _) =>
    false

  _ =>
    true
}
event :: TransitionPath -> String
export event = where {
  TransitionPath(e, _) =>
    e

  ImmediatePath(e) =>
    e
}
target :: TransitionPath -> Maybe String
export target = where {
  TransitionPath(_, d) =>
    Just(d)

  _ =>
    Nothing
}
name :: Transition pay ctx -> String
export name = pipe(
  transition,
  event,
)
transition :: Transition pay ctx -> TransitionPath
export transition = where {
  Transition(t, _) =>
    t

  ImmediateTransition(t, _) =>
    t
}
focus :: Transition pay ctx -> Maybe String
export focus = pipe(
  transition,
  target,
)
export modifiers = where {
  Transition(_, m) =>
    m

  ImmediateTransition(_, m) =>
    m
}
onlyMod = (filt, x) => pipe(
  modifiers,
  List.filter(filt),
)(x)
actions :: Transition pay ctx -> List (TransitionModifier pay ctx)
export actions = onlyMod(Modifier.isAction)
guards :: Transition pay ctx -> List (TransitionModifier pay ctx)
export guards = onlyMod(Modifier.isGuard)
reducers :: Transition pay ctx -> List (TransitionModifier pay ctx)
export reducers = onlyMod(Modifier.isReducer)
checkGuard :: (Show pay, Show ctx) => String -> pay -> Maybe ctx -> Transition pay ctx -> Boolean
export checkGuard = (ev, pay, ctx, tr) => pipe(
  guards,
  List.reduce((passing, a) => passing && Guard.check(ev, pay, ctx, a), true),
)(tr)
checkMany :: (Show pay, Show ctx) => String
  -> pay
  -> Maybe ctx
  -> List (Transition pay ctx)
  -> Boolean
export checkMany = (ev, pay, ctx, trx) => List.reduce(
  (passing, a) => Log
    .env
    .guard(
      "checking transitions: " ++ ev,
      if (passing) {
        pipe(
          checkGuard(ev, pay, ctx),
        )(a)
      } else {
        false
      },
    ),
  true,
  trx,
)
export checkImmediate = (pay, ctx, trx) => List.reduce(
  (passing, a) => {
    ev = name(a)
    return Log
      .env
      .guard(
        "checking immediate transitions: " ++ ev,
        if (passing) {
          pipe(
            checkGuard(ev, pay, ctx),
          )(a)
        } else {
          false
        },
      )
  },
  true,
  trx,
)
toPair :: TransitionPath -> #[String, String]
export toPair = where {
  TransitionPath(a, b) =>
    #[a, b]

  ImmediatePath(a) =>
    #[a, ""]
}
toSimplePair :: Transition pay ctx -> #[String, String]
export toSimplePair = pipe(
  transition,
  toPair,
)
