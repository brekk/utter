// basic accessors

context :: Controller pay ctx -> Maybe ctx
export context = where {
  Controller(ctx, _, _, _) =>
    ctx

  _ =>
    Nothing
}
machine :: Controller pay ctx -> Machine pay ctx
export machine = where {
  InvalidController(_, mch, _) =>
    mch

  Controller(_, mch, _, _) =>
    mch
}
state :: Controller pay ctx -> Stateish pay ctx
export state = where {
  Controller(_, _, st, _) =>
    st

  _ =>
    Nothing
}
// basic mutators
setContext :: Maybe ctx -> Controller pay ctx -> Controller pay ctx
export setContext = (cty, ctrl) => where(ctrl) {
  Controller(_, a, b, c) =>
    Controller(cty, a, b, c)

  _ =>
    ctrl
}
setMachine :: Machine pay ctx -> Controller pay ctx -> Controller pay ctx
export setMachine = (mch, ctrl) => where(ctrl) {
  Controller(a, _, b, c) =>
    Controller(a, mch, b, c)

  _ =>
    ctrl
}
setState :: Stateish pay ctx -> Controller pay ctx -> Controller pay ctx
export setState = (st, ctrl) => where(ctrl) {
  Controller(a, b, _, c) =>
    Controller(a, Machine.setState(st, b), st, c)

  _ =>
    ctrl
}
// given an event map and some states, look up a possible state
stateFromEvent :: Dictionary String (Dictionary String String)
  -> List (State pay ctx)
  -> String
  -> String
  -> Stateish pay ctx
export stateFromEvent = (eventMap, states, stateName, eventName) => pipe(
  Dict.get(stateName),
  chain(Dict.get(eventName)),
  chain(
    pipe(
      _State.nameMatches,
      List.find($, states),
    ),
  ),
)(eventMap)
// _step does not check validity based on guards!
_step :: String -> String -> Machine pay ctx -> Stateish pay ctx
_step = (ev, stateName, mch) => if (Machine.hasEvent(ev, mch)) {
  pipe(
    stateFromEvent(Machine.eventMap(mch), Machine.rawStates(mch), stateName),
  )(ev)
} else {
  Nothing
}
// stepWithPayload does not check validity either!
// it is the default interior run step for the Controller
_stepWithPayload :: Machine pay ctx
  -> Stateish pay ctx
  -> String
  -> Either (Stateish pay ctx) (Stateish pay ctx)
_stepWithPayload = (mch, current, ev) => where(current) {
  Just(State(stateName, trx)) =>
    Right(_step(ev, stateName, mch))

  _ =>
    Left(current)
}
// apply all action reducers and transform the current context
processReducers :: (Show pay, Show ctx) => String
  -> pay
  -> Maybe ctx
  -> Transition pay ctx
  -> Maybe ctx
processReducers = (ev, payload, ctx, tr) => pipe(
  Transition.reducers,
  List.reduce(ActionReducer.reduce(ev, payload), ctx),
)(tr)
// apply all actions and fire side effects
processActionsWithFilter :: (Show pay, Show ctx) => (TransitionModifier pay ctx -> Boolean)
  -> String
  -> pay
  -> Maybe ctx
  -> Transition pay ctx
  -> Maybe ctx
processActionsWithFilter = (filter, ev, payload, ctx, tr) => pipe(
  Transition.actions,
  List.filter(filter),
  List.reduce(
    (_ctx, action) => do {
      _Action.invoke(ev, payload, ctx, action)
      return _ctx
    },
    ctx,
  ),
)(tr)
processActions = processActionsWithFilter(Modifier.isAction)
postprocessActions = processActionsWithFilter(Modifier.isPostAction)
processAllImmediateTransitions :: (Show pay, Show ctx) => String
  -> pay
  -> Maybe ctx
  -> Transitions pay ctx
  -> #[Maybe String, Maybe ctx]
processAllImmediateTransitions = (stateName, payload, _ctx, trx) => pipe(
  List.reduce(
    (#[st, innerCtx], tr) => {
      return if (Transition.checkImmediate(payload, innerCtx, tr)) do {
        // jimble jamble up an event from thin snare

        ev = Transition.name(tr)
        // actions get the current context but don't change it
        processActions(ev, payload, innerCtx, tr)
        // reducers change it
        postctx = processReducers(ev, payload, innerCtx, tr)
        // post actions get the updated content and don't change it
        // ctrl2 = processActionControllers(ctrl, ev, payload, postctx, tr)
        postprocessActions(ev, payload, postctx, tr)
        return #[ev, postctx]
      } else {
        #[st, innerCtx]
      }
    },
    #[stateName, _ctx],
  ),
  (#[a, b]) => #[Just(a), b],
)(trx)
processAllTransitions = (ev, payload, _ctx, trx) => List.reduce(
  (innerCtx, tr) => if (Transition.checkMany(ev, payload, innerCtx, trx)) do {
    // actions get the current context but don't change it
    processActions(ev, payload, innerCtx, tr)
    // reducers change it
    postctx = processReducers(ev, payload, innerCtx, tr)
    // post actions get the updated content and don't change it
    // ctrl2 = processActionControllers(ctrl, ev, payload, postctx, tr)
    postprocessActions(ev, payload, postctx, tr)
    return postctx
  } else {
    innerCtx
  },
  _ctx,
  trx,
)
// glue to connect our context transformation to our events
applyActionsToContext :: (Show pay, Show ctx) => pay
  -> Maybe ctx
  -> String
  -> Stateish pay ctx
  -> Maybe ctx
export applyActionsToContext = (payload, ctx, ev, current) => where(current) {
  Just(State(stateName, tr)) =>
    processAllTransitions(ev, payload, ctx, tr)

  _ =>
    Nothing
}
fromTo = pipe(
  map(
    pipe(
      map(_State.name),
      fromMaybe("?"),
    ),
  ),
  String.join(" -> "),
)
// processImmediateTransitions :: (Show ctx, Eq ctx, Show pay, Eq pay) => pay
//   -> Stateish pay ctx
//   -> Maybe ctx
//   -> #[Stateish pay ctx, Maybe ctx]
processImmediateTransitions = (payload, mSt, mCtx) => where(mSt) {
  Just(State(stateName, trx)) =>
    pipe(
      List.filter(Transition.isImmediate),
      Log
        .tapped
        .interpreter("(" ++ stateName ++ "): immediate transitions to process: ", List.length),
      processAllImmediateTransitions(stateName, payload, mCtx),
    )(trx)

  _ =>
    #[Nothing, mCtx]
}
send :: (Eq ctx, Eq pay, Show ctx, Show pay) => String
  -> pay
  -> Controller pay ctx
  -> Controller pay ctx
export send = (ev, payload, ctrl) => where(ctrl) {
  Controller(ctx, mch, currentState, run) =>
    do {
      Log.env.interpreter("sending:", ev)
      return where(run(mch, currentState, ev)) {
        Right(newStateIsh) =>
          do {
            newContext = applyActionsToContext(payload, ctx, ev, currentState)
            #[mStateString, immediateContext] = processImmediateTransitions(
              payload,
              newStateIsh,
              newContext,
            )
            newStateIsh2 = Machine.getState(mStateString, mch)
            Log
              .tapped
              .interpreter("immediate state:", fromTo, [currentState, newStateIsh, newStateIsh2])

            // setState(newStateIsh2),
            return pipe(
              setContext(immediateContext),
              setState(isJust(newStateIsh2) ? newStateIsh2 : newStateIsh),
            )(ctrl)
            // return Controller(newContext, mch, newStateIsh, run)
          }

        Left(newStateIsh) =>
          do {
            Log.env.interpreter(ev ++ " did not transition", payload)
            return ctrl
          }
      }
    }

  _ =>
    ctrl
}
export fling = send($, Nothing)
