import Crypto from "Crypto"
import { Just, Nothing } from "Maybe"
import Random from "Random"



export create = (k) => {
  c :: Short
  c = 1
  and = () => {
    d = c + 1
    c := d
    return d
  }
  gen = () => k ++ "-" ++ show(and())
  return { gen }
}

