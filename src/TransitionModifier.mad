import CONSTANTS from "@/Constants"
import Log from "@/Log"
import { Action, Guard, InvalidModifier, PostAction, Reducer } from "@/Utter"



export isAction = where {
  Action(_) =>
    true

  PostAction(_) =>
    true

  _ =>
    false
}
export isPostAction = where {
  PostAction(_) =>
    true

  _ =>
    false
}
export isStrictAction = where {
  Action(_) =>
    true

  _ =>
    false
}
export isGuard = where {
  Guard(_) =>
    true

  _ =>
    false
}
export isReducer = where {
  Reducer(_) =>
    true

  _ =>
    false
}
export isInvalidModifier = where {
  InvalidModifier(_) =>
    true

  _ =>
    false
}
export orInvalid = (why, checker, x) => if (checker(x)) {
  x
} else {
  Log
    .tapped
    .modifier("Modifier processed in an invalid location", (y) => #[x, y], InvalidModifier(why))
}
export onlyGuard = orInvalid($, isGuard)
export ensureGuard = onlyGuard(CONSTANTS.EXPECTED_GUARD)
export onlyAction = orInvalid($, isAction)
export ensureAction = onlyAction(CONSTANTS.EXPECTED_ACTION)
export onlyPostAction = orInvalid($, isPostAction)
export ensurePostAction = onlyPostAction(CONSTANTS.EXPECTED_POSTACTION)
export onlyStrictAction = orInvalid($, isStrictAction)
export onlyReducer = orInvalid($, isReducer)
export ensureReducer = onlyReducer(CONSTANTS.EXPECTED_REDUCER)
