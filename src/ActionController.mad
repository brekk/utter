import type { Maybe } from "Maybe"

import type { ActionController, Controller } from "@/Types"

import { ActionController } from "@/Types"



control :: Controller pay ctx
  -> String
  -> pay
  -> Maybe ctx
  -> ActionController pay ctx
  -> Controller pay ctx
export control = (ctrl, ev, pay, ctx, act) => where(act) {
  ActionController(call) =>
    call(ctrl, ev, pay, ctx)
}
