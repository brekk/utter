import type { Either } from "Either"
import type { Maybe } from "Maybe"
import type { Set } from "Set"

import type { Secret } from "@/Closure"
import type { Event } from "@/Event"
import type { Machine } from "@/Machine"
import type { State } from "@/State"
import type { Transition } from "@/Transition"

import Dict from "Dictionary"
import { Left, Right } from "Either"
import Fn from "Function"
import IO from "IO"
import List from "List"
import { Just, Nothing, fromMaybe, isJust } from "Maybe"
import Set from "Set"

import { closed } from "@/Closure"
import Event from "@/Event"
import { log } from "@/Log"
import Machine from "@/Machine"
import SideEffect from "@/SideEffect"
import State from "@/State"
import Transition from "@/Transition"



// Event Flow
// 
// Here’s how events flow through a state machine:

// type Controller a b = Controller(Talkback a b)
/*
stateFromEvent :: Dictionary String (Dictionary String String)
  -> List (State String a)
  -> String
  -> String
  -> List (Transition a b)
  -> Maybe b
  -> Maybe (State String a)
*/
export stateFromEvent = (eventMap, states, stateName, eventName) => pipe(
  Dict.get(stateName),
  chain(Dict.get(eventName)),
  chain(
    pipe(
      State.nameMatches,
      List.find($, states),
    ),
  ),
)(eventMap)

// checkTransitions :: List (Transition a b) -> Event -> Maybe b -> Maybe a -> Boolean
export checkTransitions = (trx, ev, ctx, payload) => List.reduce(
  (pass, tr) => if (pass) {
    Transition.checkGuard(ev, payload, ctx, tr)
  } else {
    false
  },
  true,
  trx,
)

findEvent :: String -> List Event -> Event
export findEvent = (e, evs) => pipe(
  List.find(
    pipe(
      Event.name,
      Fn.equals(e),
    ),
  ),
  fromMaybe(Event.NullEvent),
)(evs)

// Current state checked: Machine looks at transitions in the current state
// Guards evaluated: If guards exist, they check if transition can proceed
// Actions executed: If guards pass, actions/reducers run
// State changes: Machine transitions to target state
// Listeners notified: Any change listeners are called

// invoke :: Secret a -> String -> String -> Machine a b -> Maybe (State a b)
export step = (ev, stateName, mch) => if (Set.includes(ev, Machine.eventNames(mch))) {
  pipe(
    stateFromEvent(Machine.eventMap(mch), Machine.states(mch), stateName),
    log.interpreter("Setting new state!"),
  )(ev)
} else {
  Nothing
}

export type Controller pay ctx
  = InvalidController(String)
  | Controller(
    Maybe (State pay ctx),
    Maybe (State pay ctx) -> String -> Maybe pay -> Maybe (State pay ctx),
  )

shouldRun = (ctx, mch, ev, current, payload) => where(current) {
  Just(State.State(stateName, transitions)) =>
    do {
      return checkTransitions(
        transitions,
        findEvent(ev, Set.toList(Machine.events(mch))),
        ctx,
        payload,
      )
    }

  _ =>
    false
}

stepWithPayload = (ctx, mch, current, ev, payload) => if (
  shouldRun(ctx, mch, ev, current, payload)
) {
  where(current) {
    Just(State.State(stateName, transitions)) =>
      step(ev, stateName, mch)

    _ =>
      Nothing
  }
} else {
  Nothing
}

initialControl :: Maybe a -> Machine a b -> Controller a b
export initialControl = (ctx, mch) => {
  ref = Machine.initialState(mch)
  initial = log.interpreter(
    "default state!",
    isJust(ref)
      ? ref
      : pipe(
        Machine.states,
        List.first,
      )(mch),
  )

  return Controller(initial, stepWithPayload(ctx, mch))
}


export create = (ctx, mch) => {
  states = Machine.stateSet(mch)
  return if (Set.length(states) == 0) {
    InvalidController("No states")
  } else {
    initialControl(ctx, mch)
  }
}

export progress = (ev, payload, ctrl) => where(ctrl) {
  Controller(current, run) =>
    run(current, ev, payload)

  _ =>
    Nothing
}
