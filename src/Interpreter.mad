import type { Maybe } from "Maybe"

import type {
  Controller,
  Machine,
  State,
  Stateish,
  Transition,
  TransitionModifier,
  Transitions,
} from "@/Utter"

import Dict from "Dictionary"
import Fn from "Function"
import List from "List"
import { fromMaybe } from "Maybe"
import { Just, Nothing, isJust } from "Maybe"
import Set from "Set"
import String from "String"

import _Action from "@/Action"
import Log from "@/Log"
import Machine from "@/Machine"
import ActionReducer from "@/Reducer"
import _State from "@/State"
import Transition from "@/Transition"
import Modifier from "@/TransitionModifier"
import { Controller, InvalidController, State } from "@/Utter"



alias Id = String
initialControl :: (Eq ctx, Show ctx) => Id -> Maybe ctx -> Machine pay ctx -> Controller pay ctx
export initialControl = (id, mCtx, mch) => {
  ref = Machine.state(mch)

  return pipe(
    Controller(id, mCtx, mch, $, _stepWithPayload),
  )(isJust(ref) ? ref : Machine.firstState(mch))
}
noStates :: Machine pay ctx -> Boolean
export noStates = pipe(
  Machine.states,
  Set.length,
  Fn.equals(0),
)
create :: (Show ctx, Eq ctx) => Id -> Maybe ctx -> Machine pay ctx -> Controller pay ctx
export create = (id, ctx, mch) => pipe(
  Fn.ifElse(
    noStates,
    InvalidController("utter:ly:aimless", "No states", $, Set.empty),
    initialControl(id, ctx),
  ),
)(mch)
