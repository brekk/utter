import Dict from "Dictionary"
import { Left, Right } from "Either"
import Fn from "Function"
import IO from "IO"
import List from "List"
import { Just, Nothing, fromMaybe, isJust } from "Maybe"
import Set from "Set"

import { closed } from "@/Closure"
import Event from "@/Event"
import { log } from "@/Log"
import Machine from "@/Machine"
import SideEffect from "@/SideEffect"
import State from "@/State"
import Transition from "@/Transition"



// Event Flow
// 
// Here’s how events flow through a state machine:

// type Controller a b = Controller(Talkback a b)
/*
stateFromEvent :: Dictionary String (Dictionary String String)
  -> List (State String a)
  -> String
  -> String
  -> List (Transition a b)
  -> Maybe b
  -> Maybe (State String a)
*/
export stateFromEvent = (eventMap, states, stateName, eventName) => pipe(
  Dict.get(stateName),
  chain(Dict.get(eventName)),
  chain((k) => List.find(State.nameMatches(k), states)),
)(eventMap)

checkTransitions :: List (Transition pay ctx) -> Event -> Maybe ctx -> Maybe pay -> Boolean
export checkTransitions = (trx, ev, ctx, payload) => List.reduce(
  (pass, tr) => if (pass) {
    Transition.checkGuard(ev, payload, ctx, tr)
  } else {
    false
  },
  true,
  trx,
)

findEvent :: String -> List Event -> Event
export findEvent = (e, evs) => pipe(
  List.find(
    pipe(
      Event.name,
      Fn.equals(e),
    ),
  ),
  fromMaybe(Event.NullEvent),
)(evs)

// Current state checked: Machine looks at transitions in the current state
// Guards evaluated: If guards exist, they check if transition can proceed
// Actions executed: If guards pass, actions/reducers run
// State changes: Machine transitions to target state
// Listeners notified: Any change listeners are called


/*
invoke :: Secret a
  -> String
  -> String
  -> Machine a b
  -> Maybe (State (List (Transition a b) -> Maybe b -> Maybe (State String a)) a)
*/
export invoke = (secret, ev, stateName, mch) => if (Set.includes(ev, Machine.eventNames(mch))) do {
  pipe(
    stateFromEvent(Machine.eventMap(mch), Machine.states(mch), stateName),
    log.interpreter("Setting new state!"),
    secret.set,
  )
  return true
} else {
  false
}



checkTransition = (mch, ctx, ev, raw, payload) => where(raw) {
  State.State(stateName, transitions) =>
    checkTransitions(transitions, findEvent(ev, Set.toList(Machine.events(mch))), ctx, payload)
}

processEvent = (secret, mch, ctx, ev, payload) => {
  current = secret.get()
  return if (checkTransition(mch, ctx, ev, current, payload)) {
    where(current) {
      State.State(stateName, transitions) =>
        invoke(secret, ev, stateName, mch)
    }
  } else {
    false
  }
}


// export type Controller pay ctx = Controller({} -> State pay ctx, String -> Maybe pay -> Boolean)

// consumeMachine :: Maybe a -> Machine a b -> Controller a b
export consumeMachine = (ctx, mch) => {
  ref = Machine.initialState(mch)
  return map(
    (init) => pipe(
      closed,
      log.interpreter("default state!"),
      // (secret) => {
      //   sendWithPayload = processEvent(secret, mch, ctx)
      //   return { get: secret.get, sendWithPayload }
      // },



    )(init),
  )(
    isJust(ref)
      ? ref
      : pipe(
        Machine.states,
        List.first,
      )(mch),
  )
  // shouldRun :: String -> Maybe (State pay ctx) -> Maybe pay -> Boolean
  // shouldRun :: String -> State pay ctx -> Maybe pay -> Boolean
}



// interpret :: Maybe a -> Machine a b -> Either String (Controller a b)
export interpret = (ctx, mch) => {
  states = Machine.stateSet(mch)
  return if (Set.length(states) == 0) {
    Left("No states")
  } else {
    where(consumeMachine(ctx, mch)) {
      Just(x) =>
        Right(x)

      Nothing =>
        Left("Error consuming")
    }
  }
}
