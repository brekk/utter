import type { Maybe } from "Maybe"

import type { Machine } from "@/Machine"
import type { State } from "@/State"
import type { Transition } from "@/Transition"

import Dict from "Dictionary"
import Fn from "Function"
import List from "List"
import { Just, Nothing, fromMaybe, isJust } from "Maybe"
import Set from "Set"

import Action from "@/Action"
import Log from "@/Log"
import Machine from "@/Machine"
import ActionReducer from "@/Reducer"
import State from "@/State"
import Transition from "@/Transition"



export alias Stateish pay ctx = Maybe (State pay ctx)
export type Controller pay ctx
  = InvalidController(String, Machine pay ctx)
  | Controller(
    Maybe ctx,
    Machine pay ctx,
    Stateish pay ctx,
    Stateish pay ctx -> String -> Maybe pay -> Stateish pay ctx,
  )
stateFromEvent :: Dictionary String (Dictionary String String)
  -> List (State pay ctx)
  -> String
  -> String
  -> Stateish pay ctx
export stateFromEvent = (eventMap, states, stateName, eventName) => pipe(
  Dict.get(stateName),
  chain(Dict.get(eventName)),
  chain(
    pipe(
      State.nameMatches,
      List.find($, states),
    ),
  ),
)(eventMap)
checkTransitions :: List (Transition pay ctx) -> Maybe String -> Maybe ctx -> Maybe pay -> Boolean
export checkTransitions = (trx, maybeEv, ctx, payload) => where(maybeEv) {
  Just(ev) =>
    List.reduce(
      (pass, tr) => if (pass) {
        Transition.checkGuard(ev, payload, ctx, tr)
      } else {
        false
      },
      true,
      trx,
    )

  _ =>
    false
}
findEvent :: String -> List String -> Maybe String
export findEvent = (e, evs) => pipe(
  List.find(Fn.equals(e)),
)(evs)
step :: (Show pay, Show ctx) => String -> String -> Machine pay ctx -> Stateish pay ctx
export step = (ev, stateName, mch) => if (Set.includes(ev, Machine.events(mch))) {
  pipe(
    stateFromEvent(Machine.eventMap(mch), Machine.rawStates(mch), stateName),
    Log.env.interpreter("Setting new state!"),
  )(ev)
} else {
  Nothing
}
context :: Controller pay ctx -> Maybe ctx
export context = where {
  Controller(ctx, _, _, _) =>
    ctx

  _ =>
    Nothing
}
machine :: Controller pay ctx -> Machine pay ctx
export machine = where {
  InvalidController(_, mch) =>
    mch

  Controller(_, mch, _, _) =>
    mch
}
state :: Controller pay ctx -> Stateish pay ctx
export state = where {
  Controller(_, _, st, _) =>
    st

  _ =>
    Nothing
}
shouldRun :: Maybe ctx -> Machine pay ctx -> String -> Stateish pay ctx -> Maybe pay -> Boolean
export shouldRun = (ctx, mch, ev, curr, pay) => where(curr) {
  Just(State.State(stateName, trx)) =>
    checkTransitions(trx, findEvent(ev, Set.toList(Machine.events(mch))), ctx, pay)

  _ =>
    false
}
stepWithPayload :: (Eq ctx, Eq pay, Show ctx, Show pay) => Maybe ctx
  -> Machine pay ctx
  -> Stateish pay ctx
  -> String
  -> Maybe pay
  -> Stateish pay ctx
export stepWithPayload = (ctx, mch, current, ev, payload) => if (
  shouldRun(ctx, mch, ev, current, payload)
) {
  where(current) {
    Just(State.State(stateName, tr)) =>
      step(ev, stateName, mch)

    _ =>
      Nothing
  }
} else {
  Nothing
}
processReducers :: String -> Maybe pay -> Maybe ctx -> Transition pay ctx -> Maybe ctx
processReducers = (ev, payload, ctx, tr) => {
  _processReducers = (out, input) => where(input) {
    [] =>
      out

    [action, ...actions] =>
      pipe(
        ActionReducer.reduce(ev, out, payload),
        _processReducers($, actions),
      )(action)
  }
  return _processReducers(ctx, Transition.reducers(tr))
}
processActions :: String -> Maybe pay -> Maybe ctx -> Transition pay ctx -> Maybe ctx
processActions = (ev, payload, ctx, tr) => {
  _processActions = (out, input) => where(input) {
    [] =>
      out

    [action, ...actions] =>
      do {
        Action.invoke(ev, out, payload, action)
        return _processActions($, actions)
      }
  }
  return _processActions(ctx, Transition.actions(tr))
}
processAllTransitions = (ev, payload, ctx, trx) => {
  _processAllTransitions = (out, transitions) => where(transitions) {
    [] =>
      out

    [tr, ...trans] =>
      pipe(
        (x) => do {
          // actions get the current context but don't change it
          processActions(ev, payload, out, x)
          // reducers change it
          return processReducers(ev, payload, out, x)
        },
        _processAllTransitions($, trans),
      )(tr)
  }
  return _processAllTransitions(ctx, trx)
}
export applyActionsToContext = (ctx, current, ev, payload) => where(current) {
  Just(State.State(stateName, tr)) =>
    processAllTransitions(ev, payload, ctx, tr)

  _ =>
    Nothing
}
getFirstState = pipe(
  Machine.rawStates,
  List.first,
)
initialControl :: (Eq a, Show a) => Maybe a -> Machine a b -> Controller a b
export initialControl = (ctx, mch) => {
  ref = Machine.state(mch)

  return pipe(
    Log.env.interpreter("default state!"),
    Controller(ctx, mch, $, stepWithPayload(ctx, mch)),
  )(isJust(ref) ? ref : getFirstState(mch))
}
noStates :: Machine a b -> Boolean
export noStates = pipe(
  Machine.states,
  Set.length,
  Fn.equals(0),
)
create :: (Show ctx, Eq ctx) => Maybe ctx -> Machine ctx pay -> Controller ctx pay
export create = (ctx, mch) => Fn.ifElse(
  noStates,
  InvalidController("No states"),
  initialControl(ctx),
)(mch)
send :: (Eq ctx, Eq pay, Show ctx, Show pay) => String
  -> Maybe pay
  -> Controller pay ctx
  -> Controller pay ctx
export send = (ev, payload, ctrl) => where(ctrl) {
  Controller(ctx, mch, current, run) =>
    do {
      newContext = applyActionsToContext(ctx, current, ev, payload)
      return Controller(
        newContext,
        mch,
        run(current, ev, payload),
        stepWithPayload(newContext, mch),
      )
    }

  _ =>
    ctrl
}

// Current state checked: Machine looks at transitions in the current state
// Guards evaluated: If guards exist, they check if transition can proceed
// Actions executed: If guards pass, actions/reducers run
// State changes: Machine transitions to target state
// Listeners notified: Any change listeners are called
