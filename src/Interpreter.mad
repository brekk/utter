import type { Maybe } from "Maybe"

import type { Machine } from "@/Machine"
import type { State } from "@/State"
import type { CTransition } from "@/Transition"

import { lt } from "Compare"
import Dict from "Dictionary"
import Fn from "Function"
import List from "List"
import { Just, Nothing, isJust } from "Maybe"
import Set from "Set"

import Action from "@/Action"
import Log from "@/Log"
import Machine from "@/Machine"
import ActionReducer from "@/Reducer"
import State from "@/State"
import Transition from "@/Transition"



export alias Stateish pay ctx = Maybe (State pay ctx)
export type Controller pay ctx
  = InvalidController(String, Machine pay ctx, Set String)
  | Controller(
    Maybe ctx,
    Machine pay ctx,
    Stateish pay ctx,
    Maybe ctx -> Machine pay ctx -> Stateish pay ctx -> String -> pay -> Stateish pay ctx,
  )
getFirstState :: Machine pay ctx -> Stateish pay ctx
getFirstState = pipe(
  Machine.rawStates,
  List.first,
)
initialControl :: (Eq ctx, Show ctx) => Maybe ctx -> Machine pay ctx -> Controller pay ctx
export initialControl = (mCtx, mch) => {
  ref = Machine.state(mch)

  return pipe(
    Controller(mCtx, mch, $, stepWithPayload),
  )(isJust(ref) ? ref : getFirstState(mch))
}
noStates :: Machine pay ctx -> Boolean
export noStates = pipe(
  Machine.states,
  Set.length,
  Fn.equals(0),
)
create :: (Show ctx, Eq ctx) => Maybe ctx -> Machine pay ctx -> Controller pay ctx
export create = (ctx, mch) => pipe(
  Fn.ifElse(noStates, InvalidController("No states", $, Set.empty), initialControl(ctx)),
)(mch)
safeCreate :: (Show ctx, Eq ctx) => Maybe ctx -> Machine pay ctx -> Controller pay ctx
export safeCreate = (ctx, mch) => pipe(
  Machine.findIncomplete,
  Fn.ifElse(
    pipe(
      Set.length,
      lt(0),
    ),
    Fn.always(create(ctx, mch)),
    InvalidController("Machine incomplete", mch),
  ),
)(mch)
// basic accessors

context :: Controller pay ctx -> Maybe ctx
export context = where {
  Controller(ctx, _, _, _) =>
    ctx

  _ =>
    Nothing
}
machine :: Controller pay ctx -> Machine pay ctx
export machine = where {
  InvalidController(_, mch, _) =>
    mch

  Controller(_, mch, _, _) =>
    mch
}
state :: Controller pay ctx -> Stateish pay ctx
export state = where {
  Controller(_, _, st, _) =>
    st

  _ =>
    Nothing
}
// basic mutators
setContext :: Maybe ctx -> Controller pay ctx -> Controller pay ctx
export setContext = (cty, ctrl) => where(ctrl) {
  Controller(_, a, b, c) =>
    Controller(cty, a, b, c)

  _ =>
    ctrl
}
setMachine :: Machine pay ctx -> Controller pay ctx -> Controller pay ctx
export setMachine = (mch, ctrl) => where(ctrl) {
  Controller(a, _, b, c) =>
    Controller(a, mch, b, c)

  _ =>
    ctrl
}
setState :: Stateish pay ctx -> Controller pay ctx -> Controller pay ctx
export setState = (st, ctrl) => where(ctrl) {
  Controller(a, b, _, c) =>
    Controller(a, b, st, c)

  _ =>
    ctrl
}
// given an event map and some states, look up a possible state
stateFromEvent :: Dictionary String (Dictionary String String)
  -> List (State pay ctx)
  -> String
  -> String
  -> Stateish pay ctx
export stateFromEvent = (eventMap, states, stateName, eventName) => pipe(
  Dict.get(stateName),
  chain(Dict.get(eventName)),
  chain(
    pipe(
      State.nameMatches,
      List.find($, states),
    ),
  ),
)(eventMap)
// step does not check validity based on guards!
step :: String -> String -> Machine pay ctx -> Stateish pay ctx
export step = (ev, stateName, mch) => if (Machine.hasEvent(ev, mch)) {
  pipe(
    stateFromEvent(Machine.eventMap(mch), Machine.rawStates(mch), stateName),
  )(ev)
} else {
  Nothing
}
// stepWithPayload does check validity
// it is the default interior run step for the Controller
stepWithPayload :: Maybe ctx
  -> Machine pay ctx
  -> Stateish pay ctx
  -> String
  -> pay
  -> Stateish pay ctx
export stepWithPayload = (ctx, mch, current, ev, payload) => where(current) {
  Just(State.State(stateName, trx)) =>
    if (Transition.checkMany(ev, payload, ctx, trx)) {
      step(ev, stateName, mch)
    } else {
      current
    }

  _ =>
    Nothing
}
// apply all action reducers and transform the current context
processReducers :: String -> pay -> Maybe ctx -> CTransition pay ctx -> Maybe ctx
processReducers = (ev, payload, ctx, tr) => pipe(
  Transition.reducers,
  List.reduce(ActionReducer.reduce(ev, payload), ctx),
)(tr)
// apply all actions and fire side effects
processActions :: String -> pay -> Maybe ctx -> CTransition pay ctx -> Maybe ctx
processActions = (ev, payload, ctx, tr) => pipe(
  Transition.actions,
  List.reduce(
    (_ctx, action) => do {
      Action.invoke(ev, payload, ctx, action)
      return _ctx
    },
    ctx,
  ),
)(tr)
// apply all transitions to context, if guards pass
processAllTransitions :: String -> pay -> Maybe ctx -> List (CTransition pay ctx) -> Maybe ctx
processAllTransitions = (ev, payload, _ctx, trx) => List.reduce(
  (ctx, tr) => if (Transition.checkMany(ev, payload, ctx, trx)) do {
    // actions get the current context but don't change it
    processActions(ev, payload, ctx, tr)
    // reducers change it
    return processReducers(ev, payload, ctx, tr)
  } else {
    ctx
  },
  _ctx,
  trx,
)
// glue to connect our context transformation to our events
applyActionsToContext :: pay -> Maybe ctx -> String -> Stateish pay ctx -> Maybe ctx
export applyActionsToContext = (payload, ctx, ev, current) => where(current) {
  Just(State.State(stateName, tr)) =>
    processAllTransitions(ev, payload, ctx, tr)

  _ =>
    Nothing
}
send :: Show pay => String -> pay -> Controller pay ctx -> Controller pay ctx
export send = (ev, payload, ctrl) => where(ctrl) {
  Controller(ctx, mch, currentState, run) =>
    do {
      newContext = applyActionsToContext(payload, ctx, ev, currentState)
      newStateIsh = run(ctx, mch, currentState, ev, payload)
      return if (isJust(newStateIsh)) {
        Controller(newContext, mch, newStateIsh, run)
      } else do {
        Log.env.interpreter(ev ++ " failed", payload)
        return ctrl
      }
    }

  _ =>
    ctrl
}
export fling = send($, Nothing)
