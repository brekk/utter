import type { Maybe } from "Maybe"

import type { Controller, Machine, State, Stateish, Transition, TransitionModifier } from "@/Utter"

import Dict from "Dictionary"
import Fn from "Function"
import List from "List"
import { fromMaybe } from "Maybe"
import { Just, Nothing, isJust } from "Maybe"
import Set from "Set"
import String from "String"

import _Action from "@/Action"
import Log from "@/Log"
import Machine from "@/Machine"
import ActionReducer from "@/Reducer"
import _State from "@/State"
import Transition from "@/Transition"
import Modifier from "@/TransitionModifier"
import { Controller, InvalidController, State } from "@/Utter"



initialControl :: (Eq ctx, Show ctx) => Maybe ctx -> Machine pay ctx -> Controller pay ctx
export initialControl = (mCtx, mch) => {
  ref = Machine.state(mch)

  return pipe(
    Controller(mCtx, mch, $, _stepWithPayload),
  )(isJust(ref) ? ref : Machine.firstState(mch))
}
noStates :: Machine pay ctx -> Boolean
export noStates = pipe(
  Machine.states,
  Set.length,
  Fn.equals(0),
)
create :: (Show ctx, Eq ctx) => Maybe ctx -> Machine pay ctx -> Controller pay ctx
export create = (ctx, mch) => pipe(
  Fn.ifElse(noStates, InvalidController("No states", $, Set.empty), initialControl(ctx)),
)(mch)
safeCreate :: (Show ctx, Eq ctx) => Maybe ctx -> Machine pay ctx -> Controller pay ctx
export safeCreate = (ctx, mch) => pipe(
  Machine.findIncomplete,
  Fn.ifElse(
    pipe(
      Set.length,
      Log.env.interpreter("incomplete values"),
      (x) => x == 0,
      Log.env.interpreter("incomplete?"),
    ),
    Fn.always(create(ctx, mch)),
    InvalidController("Machine incomplete", mch),
  ),
)(mch)
// basic accessors

context :: Controller pay ctx -> Maybe ctx
export context = where {
  Controller(ctx, _, _, _) =>
    ctx

  _ =>
    Nothing
}
machine :: Controller pay ctx -> Machine pay ctx
export machine = where {
  InvalidController(_, mch, _) =>
    mch

  Controller(_, mch, _, _) =>
    mch
}
state :: Controller pay ctx -> Stateish pay ctx
export state = where {
  Controller(_, _, st, _) =>
    st

  _ =>
    Nothing
}
// basic mutators
setContext :: Maybe ctx -> Controller pay ctx -> Controller pay ctx
export setContext = (cty, ctrl) => where(ctrl) {
  Controller(_, a, b, c) =>
    Controller(cty, a, b, c)

  _ =>
    ctrl
}
setMachine :: Machine pay ctx -> Controller pay ctx -> Controller pay ctx
export setMachine = (mch, ctrl) => where(ctrl) {
  Controller(a, _, b, c) =>
    Controller(a, mch, b, c)

  _ =>
    ctrl
}
setState :: Stateish pay ctx -> Controller pay ctx -> Controller pay ctx
export setState = (st, ctrl) => where(ctrl) {
  Controller(a, b, _, c) =>
    Controller(a, Machine.setState(st, b), st, c)

  _ =>
    ctrl
}
_setRunner = (r, ctrl) => where(ctrl) {
  Controller(a, b, c, _) =>
    Controller(a, b, c, r)

  _ =>
    ctrl
}
// given an event map and some states, look up a possible state
stateFromEvent :: Dictionary String (Dictionary String String)
  -> List (State pay ctx)
  -> String
  -> String
  -> Stateish pay ctx
export stateFromEvent = (eventMap, states, stateName, eventName) => pipe(
  Dict.get(stateName),
  chain(Dict.get(eventName)),
  chain(
    pipe(
      _State.nameMatches,
      List.find($, states),
    ),
  ),
)(eventMap)
// _step does not check validity based on guards!
_step :: String -> String -> Machine pay ctx -> Stateish pay ctx
_step = (ev, stateName, mch) => if (Machine.hasEvent(ev, mch)) {
  pipe(
    stateFromEvent(Machine.eventMap(mch), Machine.rawStates(mch), stateName),
  )(ev)
} else {
  Nothing
}
// stepWithPayload does not check validity either!
// it is the default interior run step for the Controller
_stepWithPayload :: Maybe ctx -> Machine pay ctx -> Stateish pay ctx -> String -> Stateish pay ctx
_stepWithPayload = (mCtx, mch, current, ev) => where(#[mCtx, current]) {
  #[Just(ctx), Just(State(stateName, trx))] =>
    _step(ev, stateName, mch)

  _ =>
    Nothing
}
// apply all action reducers and transform the current context
processReducers :: (Show pay, Show ctx) => String
  -> pay
  -> Maybe ctx
  -> Transition pay ctx
  -> Maybe ctx
processReducers = (ev, payload, ctx, tr) => pipe(
  Transition.reducers,
  List.reduce(ActionReducer.reduce(ev, payload), ctx),
)(tr)
// apply all actions and fire side effects
processActionsWithFilter :: (Show pay, Show ctx) => (TransitionModifier pay ctx -> Boolean)
  -> String
  -> pay
  -> Maybe ctx
  -> Transition pay ctx
  -> Maybe ctx
processActionsWithFilter = (filter, ev, payload, ctx, tr) => pipe(
  Transition.actions,
  List.filter(filter),
  List.reduce(
    (_ctx, action) => do {
      _Action.invoke(ev, payload, ctx, action)
      return _ctx
    },
    ctx,
  ),
)(tr)
processActions = processActionsWithFilter(Modifier.isAction)
postprocessActions = processActionsWithFilter(Modifier.isPostAction)
processAllImmediateTransitions :: (Show pay, Show ctx) => pay
  -> Maybe ctx
  -> List (Transition pay ctx)
  -> Maybe ctx
processAllImmediateTransitions = (payload, _ctx, trx) => List.reduce(
  (innerCtx, tr) => if (Transition.checkImmediate(payload, innerCtx, trx)) do {
    ev = Transition.name(tr)
    // actions get the current context but don't change it
    processActions(ev, payload, innerCtx, tr)
    // reducers change it
    postctx = processReducers(ev, payload, innerCtx, tr)
    // post actions get the updated content and don't change it
    // ctrl2 = processActionControllers(ctrl, ev, payload, postctx, tr)
    postprocessActions(ev, payload, postctx, tr)
    return postctx
  } else {
    innerCtx
  },
  _ctx,
  trx,
)
// apply all transitions to context, if guards pass
processAllTransitions :: (Show pay, Show ctx) => String
  -> pay
  -> Maybe ctx
  -> List (Transition pay ctx)
  -> Maybe ctx
processAllTransitions = (ev, payload, _ctx, trx) => List.reduce(
  (innerCtx, tr) => if (Transition.checkMany(ev, payload, innerCtx, trx)) do {
    // actions get the current context but don't change it
    processActions(ev, payload, innerCtx, tr)
    // reducers change it
    postctx = processReducers(ev, payload, innerCtx, tr)
    // post actions get the updated content and don't change it
    // ctrl2 = processActionControllers(ctrl, ev, payload, postctx, tr)
    postprocessActions(ev, payload, postctx, tr)
    return postctx
  } else {
    innerCtx
  },
  _ctx,
  trx,
)
// glue to connect our context transformation to our events
applyActionsToContext :: (Show pay, Show ctx) => pay
  -> Maybe ctx
  -> String
  -> Stateish pay ctx
  -> Maybe ctx
export applyActionsToContext = (payload, ctx, ev, current) => where(current) {
  Just(State(stateName, tr)) =>
    processAllTransitions(ev, payload, ctx, tr)

  _ =>
    Nothing
}
fromTo = pipe(
  map(
    pipe(
      map(_State.name),
      fromMaybe("?"),
    ),
  ),
  String.join(" -> "),
)
processImmediateTransitions :: (Show ctx, Eq ctx, Show pay, Eq pay) => pay
  -> Stateish pay ctx
  -> Maybe ctx
  -> Maybe ctx
processImmediateTransitions = (payload, st, mCtx) => pipe(
  // make a monadic accessor for transitions?
  where {
    Just(State(stateName, trx)) =>
      pipe(
        List.filter(Transition.isImmediate),
        Log.tapped.interpreter("processing immediate transitions: ", List.length),
        processAllImmediateTransitions(payload, mCtx),
      )(trx)

    _ =>
      mCtx
  },
)(st)
send :: (Eq ctx, Eq pay, Show ctx, Show pay) => String
  -> pay
  -> Controller pay ctx
  -> Controller pay ctx
export send = (ev, payload, ctrl) => where(ctrl) {
  Controller(ctx, mch, currentState, run) =>
    do {
      newStateIsh = run(ctx, mch, currentState, ev)
      return if (isJust(newStateIsh)) do {
        newContext = Log
          .env
          .interpreter("context 1", applyActionsToContext(payload, ctx, ev, currentState))
        Log.tapped.interpreter("changing state:", fromTo, [currentState, newStateIsh])
        immediateContext = Log
          .env
          .interpreter("context 2", processImmediateTransitions(payload, newStateIsh, newContext))
        return pipe(
          setContext(immediateContext),
          setState(newStateIsh),
        )(ctrl)
        // return Controller(newContext, mch, newStateIsh, run)
      } else do {
        Log.env.interpreter(ev ++ " failed", payload)
        return ctrl
      }
    }

  _ =>
    ctrl
}
export fling = send($, Nothing)
