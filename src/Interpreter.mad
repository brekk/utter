import type { Either } from "Either"
import type { Maybe } from "Maybe"
import type { Set } from "Set"

import type { Machine } from "@/Machine"
import type { State } from "@/State"

import Dict from "Dictionary"
import { Left, Right } from "Either"
import IO from "IO"
import List from "List"
import { Just, Nothing, isJust } from "Maybe"
import Set from "Set"

import { Event } from "@/Event"
import { log } from "@/Log"
import Machine from "@/Machine"
import State from "@/State"
import { Transition } from "@/Transition"



// Event Flow
// 
// Here’s how events flow through a state machine:
alias Details a b = {
  context :: Maybe a,
  eventMap :: Dictionary String (Dictionary String String),
  events :: Set String,
  states :: Set String,
}
alias Talkback a b = {
  details :: Details a b,
  get :: {} -> Maybe (State a),
  name :: String,
  send :: String -> {},
  sendWithPayload :: String -> b -> {},
}
// type Controller a b = Controller(Talkback a b)

stateFromEvent = (eventMap, states, stateName, ev) => pipe(
  Dict.get(stateName),
  // Matching transition found: Machine finds a transition with that event name
  chain(Dict.get(ev)),
  chain((k) => List.find(State.nameMatches(k), states)),
)(eventMap)

// interpret :: Show a => Maybe a -> Machine a -> Talkback a a
// interpret :: Show a => Maybe a -> Machine a -> Either String (Talkback a a)
export interpret = (context, mch) => {
  name = Machine.name(mch)
  states = Machine.stateSet(mch)
  return if (Set.length(states) == 0) do {
    log.interpreterVerbose("No states provided!")
    return Left("No states")
  } else do {
    events = Machine.events(mch)
    eventMap = Machine.eventMap(mch)
    details = { states, events, eventMap, context }
    ref = Machine.initialState(mch)
    // CURRENT IS A MAYBE
    current = log.interpreterVerbose(
      "default state!",
      isJust(ref)
        ? ref
        : pipe(
          Machine.states,
          List.first,
        )(mch),
    )
    getCurrent = () => current
    set = (x) => {
      current := x
      return x
    }
    // Event sent: service.send('eventName') is called
    sendWithPayload = (ev, p) => where(current) {
      Just(State.State(stateName, trans)) =>
        do {
          // Current state checked: Machine looks at transitions in the current state
          if (Set.includes(ev, events)) do {
            pipe(
              stateFromEvent(eventMap, Machine.states(mch), stateName),
              // Guards evaluated: If guards exist, they check if transition can proceed
              // Actions executed: If guards pass, actions/reducers run
              // State changes: Machine transitions to target state
              // Listeners notified: Any change listeners are called
              log.interpreter("Setting new state!"),
              set,
            )(ev)
            return {}
          }
          return {}
        }

      _ =>
        {}
    }
    send = sendWithPayload($, Nothing)
    return Right({ name, details, send, sendWithPayload, get: getCurrent })
    // return Left("shit")
  }
  // return Controller({ name, details, send, sendWithPayload, get })
}
