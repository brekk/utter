K = Fn.always
export alias Stateish pay ctx = Maybe (State pay ctx)
export type Controller pay ctx
  = InvalidController(String, Machine pay ctx)
  | Controller(
    Maybe ctx,
    Machine pay ctx,
    Stateish pay ctx,
    Stateish pay ctx -> String -> Maybe pay -> Stateish pay ctx,
  )
stateFromEvent :: Dictionary String (Dictionary String String)
  -> List (State pay ctx)
  -> String
  -> String
  -> Stateish pay ctx
export stateFromEvent = (eventMap, states, stateName, eventName) => pipe(
  Dict.get(stateName),
  chain(Dict.get(eventName)),
  chain(
    pipe(
      State.nameMatches,
      List.find($, states),
    ),
  ),
)(eventMap)
checkTransitions :: List (Transition pay ctx) -> Maybe String -> Maybe ctx -> Maybe pay -> Boolean
export checkTransitions = (trx, maybeEv, ctx, payload) => where(maybeEv) {
  Just(ev) =>
    List.reduce(
      (pass, tr) => if (pass) {
        Transition.checkGuard(ev, payload, ctx, tr)
      } else {
        false
      },
      true,
      trx,
    )

  _ =>
    false
}
findEvent :: String -> List String -> Maybe String
export findEvent = (e, evs) => pipe(
  List.find(Fn.equals(e)),
)(evs)
step :: (Show pay, Show ctx) => String -> String -> Machine pay ctx -> Stateish pay ctx
export step = (ev, stateName, mch) => if (Set.includes(ev, Machine.eventNames(mch))) {
  pipe(
    stateFromEvent(Machine.eventMap(mch), Machine.states(mch), stateName),
    Log.env.interpreter("Setting new state!"),
  )(ev)
} else {
  Nothing
}
context :: Controller pay ctx -> Maybe ctx
export context = where {
  Controller(ctx, _, _, _) =>
    ctx

  _ =>
    Nothing
}
// FOR LATER REMEMBERING: STEP RETURNED A SINGLE VALUE AND IT WAS HELPFULLY OVERLOADED WITH PARTIAL PARAMS
// NOW I NEED TO MANIPULATE CONTEXT AS I GO=
machine :: Controller pay ctx -> Machine pay ctx
export machine = where {
  InvalidController(_, mch) =>
    mch

  Controller(_, mch, _, _) =>
    mch
}
state :: Controller pay ctx -> Stateish pay ctx
export state = where {
  Controller(_, _, st, _) =>
    st

  _ =>
    Nothing
}
shouldRun :: Maybe ctx -> Machine pay ctx -> String -> Stateish pay ctx -> Maybe pay -> Boolean
export shouldRun = (ctx, mch, ev, curr, pay) => where(curr) {
  Just(State.State(stateName, trx)) =>
    checkTransitions(trx, findEvent(ev, Set.toList(Machine.events(mch))), ctx, pay)

  _ =>
    false
}
stepWithPayload :: (Show ctx, Show pay) => Maybe ctx
  -> Machine pay ctx
  -> Stateish pay ctx
  -> String
  -> Maybe pay
  -> Stateish pay ctx
export stepWithPayload = (ctx, mch) => (current, ev, payload) => if (
  shouldRun(ctx, mch, ev, current, payload)
) {
  where(current) {
    Just(State.State(stateName, tr)) =>
      step(ev, stateName, mch)

    _ =>
      Nothing
  }
} else {
  Nothing
}
// _processTransition(List.append(Action.invoke(ev, ctx, payload, action), out), actions)
processTransition = (curr, ev, payload, ctx, tr) => {
  _processTransition = (out, input) => where(input) {
    [] =>
      out

    [action, ...actions] =>
      pipe(
        Action.invoke(ev, ctx, payload),
        _processTransition($, actions),
      )(action)
  }
  return _processTransition(curr, Transition.actions(tr))
}
processAllTransitions = (curr, ev, payload, ctx, trx) => {
  proTrans = processTransition(curr, ev, payload, ctx)
  _processAllTransitions = (out, transitions) => where(transitions) {
    [] =>
      out

    [tr, ...trans] =>
      _processAllTransitions(proTrans(tr), trans)
  }
  return _processAllTransitions(curr, trx)
}
export actionsForEvent = (ctx, current, ev, payload) => where(current) {
  Just(State.State(stateName, tr)) =>
    pipe(
      // processTransition(ev, payload, ctx),
      processAllTransitions(Nothing, ev, payload, ctx),
      Log.env.interpreter("---->"),
    )(tr)

  _ =>
    Nothing
}
// initialControl :: Show a => Maybe a -> Machine a b -> Controller a b
export initialControl = (ctx, mch) => {
  ref = Machine.initialState(mch)
  initial = Log
    .env
    .interpreter(
      "default state!",
      isJust(ref)
        ? ref
        : pipe(
          Machine.states,
          List.first,
        )(mch),
    )

  return Controller(ctx, mch, initial, stepWithPayload(ctx, mch))
}
export noStates = pipe(
  Machine.stateSet,
  Set.length,
  Fn.equals(0),
)
// create :: (Eq ctx, Show ctx) => Maybe ctx -> Machine pay ctx -> Controller pay ctx
export create = (ctx, mch) => Fn.ifElse(
  noStates,
  InvalidController("No states"),
  initialControl(ctx),
)(mch)
send :: (Show ctx, Show pay) => String -> Maybe pay -> Controller pay ctx -> Controller pay ctx
export send = (ev, payload, ctrl) => where(ctrl) {
  Controller(ctx, mch, current, run) =>
    do {
      actionJones = actionsForEvent(ctx, current, ev, payload)
      Log.env.interpreter("ACTION JONES", actionJones)
      return Controller(
        actionJones,
        mch,
        run(current, ev, payload),
        stepWithPayload(actionJones, mch),
      )
    }

  _ =>
    ctrl
}

// Current state checked: Machine looks at transitions in the current state
// Guards evaluated: If guards exist, they check if transition can proceed
// Actions executed: If guards pass, actions/reducers run
// State changes: Machine transitions to target state
// Listeners notified: Any change listeners are called
