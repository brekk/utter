import type { Maybe } from "Maybe"

import type { Machine } from "@/Machine"
import type { State } from "@/State"
import type { CTransition } from "@/Transition"

import Dict from "Dictionary"
import Fn from "Function"
import List from "List"
import { Just, Nothing, isJust } from "Maybe"
import Set from "Set"

import Action from "@/Action"
import Log from "@/Log"
import Machine from "@/Machine"
import ActionReducer from "@/Reducer"
import State from "@/State"
import Transition from "@/Transition"



export alias Stateish pay ctx = Maybe (State pay ctx)
export type Controller pay ctx
  = InvalidController(String, Machine pay ctx)
  | Controller(
    Maybe ctx,
    Machine pay ctx,
    Stateish pay ctx,
    Maybe ctx -> Machine pay ctx -> Stateish pay ctx -> String -> Maybe pay -> Stateish pay ctx,
  )
stateFromEvent :: Dictionary String (Dictionary String String)
  -> List (State pay ctx)
  -> String
  -> String
  -> Stateish pay ctx
export stateFromEvent = (eventMap, states, stateName, eventName) => pipe(
  Dict.get(stateName),
  chain(Dict.get(eventName)),
  chain(
    pipe(
      State.nameMatches,
      List.find($, states),
    ),
  ),
)(eventMap)
step :: (Show pay, Show ctx) => String -> String -> Machine pay ctx -> Stateish pay ctx
export step = (ev, stateName, mch) => if (Machine.hasEvent(ev, mch)) {
  pipe(
    stateFromEvent(Machine.eventMap(mch), Machine.rawStates(mch), stateName),
  )(ev)
} else {
  Nothing
}
context :: Controller pay ctx -> Maybe ctx
export context = where {
  Controller(ctx, _, _, _) =>
    ctx

  _ =>
    Nothing
}
machine :: Controller pay ctx -> Machine pay ctx
export machine = where {
  InvalidController(_, mch) =>
    mch

  Controller(_, mch, _, _) =>
    mch
}
state :: Controller pay ctx -> Stateish pay ctx
export state = where {
  Controller(_, _, st, _) =>
    st

  _ =>
    Nothing
}
setContext :: Maybe ctx -> Controller pay ctx -> Controller pay ctx
export setContext = (cty, ctrl) => where(ctrl) {
  Controller(_, a, b, c) =>
    Controller(cty, a, b, c)

  _ =>
    ctrl
}
setMachine :: Machine pay ctx -> Controller pay ctx -> Controller pay ctx
export setMachine = (mch, ctrl) => where(ctrl) {
  Controller(a, _, b, c) =>
    Controller(a, mch, b, c)

  _ =>
    ctrl
}
setState :: Stateish pay ctx -> Controller pay ctx -> Controller pay ctx
export setState = (st, ctrl) => where(ctrl) {
  Controller(a, b, _, c) =>
    Controller(a, b, st, c)

  _ =>
    ctrl
}
export stepWithPayload = (ctx, mch, current, ev, payload) => where(current) {
  Just(State.State(stateName, trx)) =>
    if (
      pipe(
        Log.env.interpreter("checking transitions for payload"),
        Transition.checkMany(ev, payload, $, trx),
      )(ctx)
    ) {
      Log.env.interpreter("running processing step", step(ev, stateName, mch))
    } else {
      Log.env.interpreter("check failed!", current)
    }

  _ =>
    Nothing
}
processReducers :: String -> Maybe pay -> Maybe ctx -> CTransition pay ctx -> Maybe ctx
processReducers = (ev, payload, ctx, tr) => pipe(
  Transition.reducers,
  List.reduce(ActionReducer.reduce(ev, payload), ctx),
)(tr)
processActions :: String -> Maybe pay -> Maybe ctx -> CTransition pay ctx -> Maybe ctx
processActions = (ev, payload, ctx, tr) => pipe(
  Transition.actions,
  List.reduce(
    (_ctx, action) => do {
      Action.invoke(ev, payload, ctx, action)
      return _ctx
    },
    ctx,
  ),
)(tr)
processAllTransitions = (ev, payload, _ctx, trx) => List.reduce(
  (ctx, tr) => if (Transition.checkMany(ev, payload, ctx, trx)) do {
    // actions get the current context but don't change it
    processActions(ev, payload, ctx, tr)
    // reducers change it

    return pipe(
      Log.env.interpreter("pre-processor"),
      processReducers(ev, payload, ctx),
      Log.env.interpreter("post-processor"),
    )(tr)
  } else {
    ctx
  },
  _ctx,
  trx,
)
export applyActionsToContext = (payload, ctx, ev, current) => where(current) {
  Just(State.State(stateName, tr)) =>
    processAllTransitions(ev, payload, ctx, tr)

  _ =>
    Nothing
}
getFirstState = pipe(
  Machine.rawStates,
  List.first,
)
initialControl :: (Eq ctx, Show ctx) => Maybe ctx -> Machine pay ctx -> Controller pay ctx
export initialControl = (ctx, mch) => {
  ref = Machine.state(mch)

  return pipe(
    Controller(ctx, mch, $, stepWithPayload),
  )(isJust(ref) ? ref : getFirstState(mch))
}
noStates :: Machine pay ctx -> Boolean
export noStates = pipe(
  Machine.states,
  Set.length,
  Fn.equals(0),
)
create :: (Show ctx, Eq ctx) => Maybe ctx -> Machine ctx pay -> Controller ctx pay
export create = (ctx, mch) => pipe(
  Fn.ifElse(noStates, InvalidController("No states"), initialControl(ctx)),
)(mch)
send :: (Eq ctx, Eq pay, Show ctx, Show pay) => String
  -> Maybe pay
  -> Controller pay ctx
  -> Controller pay ctx
export send = (ev, payload, ctrl) => where(ctrl) {
  Controller(ctx, mch, current, run) =>
    do {
      newContext = applyActionsToContext(payload, ctx, ev, current)
      newStateIsh = run(ctx, mch, current, ev, payload)
      return Controller(newContext, mch, newStateIsh, run)
    }

  _ =>
    ctrl
}

// Current state checked: Machine looks at transitions in the current state
// Guards evaluated: If guards exist, they check if transition can proceed
// Actions executed: If guards pass, actions/reducers run
// State changes: Machine transitions to target state
// Listeners notified: Any change listeners are called
