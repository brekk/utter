import type { Maybe } from "Maybe"

import type { Event } from "@/Event"
import type { Transition } from "@/Transition"

import Dict from "Dictionary"
import { Left, Right } from "Either"
import List from "List"
import { Just, Nothing, fromMaybe } from "Maybe"
import String from "String"

import Event from "@/Event"



export type MachineState a = MachineState(String, List (Transition a))

export finalState = MachineState($, [])
export state = MachineState

stateName :: MachineState a -> String
export stateName = where {
  MachineState(n, _) =>
    n
}

stateTransitions :: MachineState a -> List (Transition a)
export stateTransitions = where {
  MachineState(_, t) =>
    t
}

export type Machine a = Machine(String, List (MachineState a))

export machine = Machine

// machine: "pen"
//   ↳ state: "extended"
//       ↳ event: "click" → "contracted"
//   ↳ state: "contracted"
//       ↳ event: "click" → "extended"
