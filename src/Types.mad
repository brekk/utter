import type { Maybe } from "Maybe"

import IO from "IO"
import List from "List"
import Set from "Set"
// import { Just, Nothing, fromMaybe } from "Maybe"
import String from "String"



export type Machine pay ctx = Machine(String, List (State pay ctx), Maybe (State pay ctx))
export type State pay ctx = State(String, List (CTransition pay ctx)) | FinalState(String)
export alias Stateish pay ctx = Maybe (State pay ctx)
export type Controller pay ctx
  = InvalidController(String, Machine pay ctx, Set String)
  | Controller(
    Maybe ctx,
    Machine pay ctx,
    Stateish pay ctx,
    Machine pay ctx -> Stateish pay ctx -> String -> Stateish pay ctx,
  )
export alias GuardianFn pay ctx = String -> pay -> Maybe ctx -> Boolean
export type Guard pay ctx = Guard(String -> pay -> Maybe ctx -> Boolean)
export type Action pay ctx = Action(String -> pay -> Controller pay ctx -> Maybe ctx -> {})
export type Reducer pay ctx = Reducer(String -> pay -> Maybe ctx -> Maybe ctx)
// we had to segment these types
export type Transition = Transition(String, String)
// because previously the payload and context were being conflated with the event and target types somehow
export type CTransition pay ctx
  = ComplexTransition(
    Transition,
    List (Action pay ctx),
    List (Guard pay ctx),
    List (Reducer pay ctx),
  )
