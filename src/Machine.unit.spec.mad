import Dict from "Dictionary"
import { Just, Nothing } from "Maybe"
import Set from "Set"

import Study from "Study"

import Machine from "@/Machine"
import State from "@/State"
import Transition from "@/Transition"
import T from "@/Utter"



// wild stateful delights
THE_NOTHING_MACHINE = T.Machine("id", [], Nothing)
SELF_CENTERED = T.Transition("self-centered", T.TransitionPath("again", "only"), [])
SOLO_DOLO = T.State("only", [SELF_CENTERED])
THE_LOOPER = T.Machine("loop", [SOLO_DOLO], Just(SOLO_DOLO))
WAKE_UP_SHEEPLE = T.Transition("wake-up-sheeple", T.TransitionPath("wake up", "ragin"), [])
NOT_996_THO = T.Transition(
  "not-996-tho",
  T.TransitionPath("long day is tiring though", "sleepin"),
  [],
)
SLEEPIN = T.State("sleepin", [WAKE_UP_SHEEPLE])
RAGIN = T.State("ragin", [NOT_996_THO])
// starts out RAGIN!
THE_SLEEPER = T.Machine("circadian", [SLEEPIN, RAGIN], Just(RAGIN))
Study.report(
  Study.caseN2(Machine.create),
  "Machine.create",
  [#[#["id", []], THE_NOTHING_MACHINE], #[#["loop", [SOLO_DOLO]], THE_LOOPER]],
)
Study.report(
  Machine.name,
  "Machine.name",
  [#[THE_NOTHING_MACHINE, "id"], #[THE_LOOPER, "loop"], #[THE_SLEEPER, "circadian"]],
)
Study.report(
  Machine.rawStates,
  "Machine.rawStates",
  [#[THE_NOTHING_MACHINE, []], #[THE_LOOPER, [SOLO_DOLO]], #[THE_SLEEPER, [SLEEPIN, RAGIN]]],
)
Study.report(
  Machine.firstState,
  "Machine.firstState",
  [#[THE_NOTHING_MACHINE, Nothing], #[THE_LOOPER, Just(SOLO_DOLO)], #[THE_SLEEPER, Just(SLEEPIN)]],
)
Study.report(
  Study.caseN2(Machine.hasState),
  "Machine.hasState",
  [
    #[#["anything", THE_NOTHING_MACHINE], false],
    #[#["only", THE_LOOPER], true],
    #[#["loop", THE_LOOPER], false],
    #[#["ragin", THE_SLEEPER], true],
    #[#["slingslangin", THE_SLEEPER], false],
  ],
)
Study.report(
  Machine.state,
  "Machine.state",
  [#[THE_NOTHING_MACHINE, Nothing], #[THE_LOOPER, Just(SOLO_DOLO)], #[THE_SLEEPER, Just(RAGIN)]],
)
Study.report(
  Machine.isFinal,
  "Machine.isFinal",
  [#[THE_NOTHING_MACHINE, true], #[THE_LOOPER, false], #[THE_SLEEPER, false]],
)
Study.report(
  Study.caseN2(Machine.hasEvent),
  "Machine.hasEvent",
  [
    #[#["anything", THE_NOTHING_MACHINE], false],
    #[#["only", THE_LOOPER], false],
    #[#["again", THE_LOOPER], true],
    #[#["wake up", THE_SLEEPER], true],
    #[#["circadian", THE_SLEEPER], false],
  ],
)
Study.report(
  Machine.eventMap,
  "Machine.eventMap",
  [
    #[THE_NOTHING_MACHINE, Dict.empty],
    #[THE_LOOPER, {{ "only": {{ "again": "only" }} }}],
    #[
      THE_SLEEPER,
      {{
        "ragin": {{ "long day is tiring though": "sleepin" }},
        "sleepin": {{ "wake up": "ragin" }},
      }},
    ],
  ],
)
YEET_ME = T.State("current", [Transition.createRaw("vacation", "redirect", "elsewhere", [])])
BAD_MACHINE = T.Machine("bad", [YEET_ME], Just(YEET_ME))
Study.report(
  Machine.isComplete,
  "Machine.isComplete",
  [
    #[THE_NOTHING_MACHINE, true],
    #[THE_LOOPER, true],
    #[THE_SLEEPER, true],
    // because this machine has a transition away from the current but to a state that isn't define, it is incomplete
    #[BAD_MACHINE, false],
    // but if we add a final state, it is complete
    #[T.Machine("bad", [YEET_ME, State.createFinal("elsewhere")], Just(YEET_ME)), true],
  ],
)
Study.report(
  Machine.findIncomplete,
  "Machine.findIncomplete",
  [
    #[THE_NOTHING_MACHINE, Set.empty],
    #[THE_LOOPER, Set.empty],
    #[THE_SLEEPER, Set.empty],
    #[BAD_MACHINE, Set.fromList(["elsewhere"])],
    #[T.Machine("bad", [YEET_ME, State.createFinal("elsewhere")], Just(YEET_ME)), Set.empty],
  ],
)
