import { Just, Nothing } from "Maybe"
import Set from "Set"
import { assertEquals } from "Test"

import Study from "Study"

import Action from "@/Action"
import T from "@/Types"
import { InvalidController, Machine } from "@/Types"



xctrl = InvalidController("This is a test", Machine("test", [], Nothing), Set.empty)
Study.report(
  Study.caseN5(Action.invoke),
  "actions can be invoked",
  [
    #[
      #[
        "one",
        Just("two"),
        Just("three"),
        xctrl,
        T.Action(
          (ev, pay, ctrl, mCtx) => where(#[pay, mCtx]) {
            #[Just(_b), Just(_c)] =>
              do {
                assertEquals(#[ev, _b, _c], #["one", "two", "three"])
              }

            _ =>
              do {
                assertEquals(false, true)
              }
          },
        ),
      ],
      {},
    ],
  ],
)
