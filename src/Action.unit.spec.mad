import type { ActionFn } from "@/Utter"

import { Just, Nothing } from "Maybe"
import { assertEquals } from "Test"

import Study from "Study"

import Action from "@/Action"
import Mod from "@/Modifier"
import T from "@/Utter"



nothingActionFn :: ActionFn pay ctx
nothingActionFn = (ev, pay, mCtx) => {}
// Study.report(
//   Action.create,
//   "actions can be created, and they have an id",
//   [#[nothingActionFn, "action-2"]],
// )
// xctrl = InvalidController("This is a test", Machine("test", [], Nothing), Set.empty)
Study.report(
  Study.caseN4(Action.invoke),
  "actions can be invoked",
  [
    #[
      #[
        "one",
        Just("two"),
        Just("three"),
        T.Action(
          (ev, pay, mCtx) => where(#[pay, mCtx]) {
            #[Just(_b), Just(_c)] =>
              do {
                assertEquals(#[ev, _b, _c], #["one", "two", "three"])
              }

            _ =>
              do {
                assertEquals(false, true)
              }
          },
        ),
      ],
      {},
    ],
  ],
)
