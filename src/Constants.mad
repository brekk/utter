expectedModifier = (g) => `Expected a ${g} modifier.`
export EXPECTED_GUARD = expectedModifier("Guard")
export EXPECTED_REDUCER = expectedModifier("Reducer")
export EXPECTED_ACTION = expectedModifier("Action")
export EXPECTED_POSTACTION = expectedModifier("PostAction")
export EXPECTED_ANNOTATION = expectedModifier("Annotation")
export EXPECTED_ANNOTATION_ACTION = expectedModifier("Annotated Action")
export EXPECTED_ANNOTATION_REDUCER = expectedModifier("Annotated Reducer")
export EXPECTED_ANNOTATION_GUARD = expectedModifier("Annotated Guard")
