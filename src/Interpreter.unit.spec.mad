import { Just, Nothing } from "Maybe"
import Set from "Set"

import Study from "Study"

import Guard from "@/Guard"
import Interpreter from "@/Interpreter"
import Inter from "@/Interpreter"
import Machine from "@/Machine"
import Reducer from "@/Reducer"
import State from "@/State"
import Transition from "@/Transition"
import T from "@/Types"



UNDER_TEN = T.Guard(
  (ev, pay, mCtx) => where(mCtx) {
    Just({ count }) =>
      count + 1 < 10

    _ =>
      false
  },
)
ADD_ONE = T.Reducer(
  (ev, pay, mCtx) => where(mCtx) {
    Just({ count }) =>
      Just({ count: count + 1 })

    _ =>
      mCtx
  },
)
STATES = {
  initial: State.create("INITIAL", [Transition.createRaw("LOADING", "READY")]),
  loaded: State.create("READY", [Transition.createRaw("COUNT", "COUNTING")]),
  counting: State.create(
    "COUNTING",
    [
      Transition.create("COUNT", "COUNTING", [UNDER_TEN, ADD_ONE]),
      Transition.create("FINISH", "DONE", [Guard.invert(UNDER_TEN)]),
    ],
  ),
  done: State.createFinal("DONE"),
}
COUNTING_MACHINE = Machine.create(
  "test",
  [STATES.initial, STATES.loaded, STATES.counting, STATES.done],
)
NOTHING_MACHINE = T.Machine(
  "end",
  [STATES.initial, STATES.loaded, STATES.counting, STATES.done],
  Nothing,
)
COUNTING_SERVICE = Interpreter.create(Just({ count: 0 }), COUNTING_MACHINE)
NOTHING_SERVICE = Interpreter.create(Nothing, NOTHING_MACHINE)
BAD_SERVICE = T.InvalidController("this is a test", NOTHING_MACHINE, Set.empty)
Study.report(
  Inter.safeCreate(Just({ count: 0 })),
  "safeCreate",
  [#[COUNTING_MACHINE, COUNTING_SERVICE]],
)
Study.report(
  Study.caseN2(Inter.initialControl),
  "initialControl",
  [
    #[#[Just({ count: 0 }), COUNTING_MACHINE], COUNTING_SERVICE],
    #[#[Nothing, NOTHING_MACHINE], NOTHING_SERVICE],
  ],
)
Study.report(
  Inter.context,
  "context",
  [#[COUNTING_SERVICE, Just({ count: 0 })], #[BAD_SERVICE, Nothing]],
)
