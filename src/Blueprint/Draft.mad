import type { Either } from "Either"
import type { Maybe } from "Maybe"

import type { State } from "@/State"
import type { Transitions } from "@/Transition"

import Dict from "Dictionary"
import { Left, Right } from "Either"
import IO from "IO"
import List from "List"
import { fromMaybe } from "Maybe"
import Set from "Set"

import Sketch from "@/Blueprint/Sketch"
import { log } from "@/Log"
import Machine from "@/Machine"
import State from "@/State"
import Transition from "@/Transition"



// Drafts handle transitions, which know about payloads
export type Draft b c
  = InvalidDraft(String)
  | Draft(
    // Dictionary States Transitions
    Dictionary String (Transitions String b c),
    // states 
    Set String,
    // events
    Set String,
  )

// convert a sketch into a draft
// fromSketch :: List (State a) -> Draft String a b
fromSketch :: Show b => List (State String) -> Draft String b
export fromSketch = (stx) => pipe(
  Sketch.fromStates,
  where {
    { dict, states, events } =>
      do {
        IO.pTrace("DICT", dict)
        update = map(
          (s) => pipe(
            IO.pTrace("hoy"),
            map((t) => Transition.fromRoute(t, [], [])),
            IO.pTrace("yoy"),
          )(s),
          dict,
        )
        return Draft(update, states.defined, events)
      }
  },
)(stx)

// fromMachine :: Machine String -> Draft String String a
export fromMachine = pipe(
  Machine.states,
  fromSketch,
)

// normalize :: Comparable a => Machine a b -> Sketch a b
export normalize = pipe(
  Machine.states,
  Sketch.fromStates,
)
// validate :: Comparable a => Machine a b -> Boolean
export validate = pipe(
  normalize,
  (x) => x.error == 0,
)

