import type { Maybe } from "Maybe"
import type { Set } from "Set"

import type { Machine, State, Stateish } from "@/Utter"

import { lt } from "Compare"
import Dict from "Dictionary"
import Fn from "Function"
import List from "List"
import { Just, Nothing } from "Maybe"
import Maybe from "Maybe"
import Set from "Set"
import String from "String"
import TuplePrelude from "Tuple"

import State from "@/State"
import Transition from "@/Transition"
import Tuple from "@/Tuple"
import { Machine } from "@/Utter"



create :: String -> List (State pay ctx) -> Machine pay ctx
export create = (s, x) => Machine(s, x, List.first(x))
name :: Machine pay ctx -> String
export name = where {
  Machine(n, _, _) =>
    n
}
rawStates :: Machine pay ctx -> List (State pay ctx)
export rawStates = where {
  Machine(_, sts, _) =>
    sts
}
getState :: Maybe String -> Machine pay ctx -> Stateish pay ctx
export getState = (s, m) => pipe(
  rawStates,
  (st) => where(s) {
    Just(_s) =>
      List.find(State.nameMatches(_s), st)

    _ =>
      Nothing
  },
)(m)
states :: Machine pay ctx -> Set String
export states = pipe(
  rawStates,
  map(State.name),
  Set.fromList,
)
hasState :: String -> Machine pay ctx -> Boolean
export hasState = (x, mch) => pipe(
  states,
  Set.includes(x),
)(mch)
hasMaybeState :: Stateish pay ctx -> Machine pay ctx -> Boolean
export hasMaybeState = (mSt, mch) => pipe(
  map(
    pipe(
      State.name,
      hasState($, mch),
    ),
  ),
  Maybe.fromMaybe(false),
)(mSt)
state :: Machine pay ctx -> Maybe (State pay ctx)
export state = where {
  Machine(_, _, m) =>
    m
}
_setRawState :: Stateish pay ctx -> Machine pay ctx -> Machine pay ctx
_setRawState = (st, mch) => where(mch) {
  Machine(x, y, _) =>
    Machine(x, y, st)
}
setState :: Stateish pay ctx -> Machine pay ctx -> Machine pay ctx
export setState = (st, mch) => Fn.ifElse(
  hasMaybeState($, mch),
  _setRawState($, mch),
  Fn.always(mch),
)(st)
isFinal :: Machine pay ctx -> Boolean
export isFinal = Fn.ifElse(
  pipe(
    rawStates,
    List.length,
    lt(0),
  ),
  pipe(
    state,
    map(State.isFinal),
    Maybe.fromMaybe(false),
  ),
  Fn.always(true),
)
events :: Machine pay ctx -> Set String
export events = pipe(
  rawStates,
  chain(
    pipe(
      State.transitions,
      map(Transition.name),
    ),
  ),
  Set.fromList,
)
hasEvent :: String -> Machine pay ctx -> Boolean
export hasEvent = (ev, mch) => pipe(
  events,
  Set.includes(ev),
)(mch)
eventMap :: Machine pay ctx -> Dictionary String (Dictionary String String)
export eventMap = pipe(
  rawStates,
  map(
    pipe(
      State.toPair,
      Tuple.mapSnd(
        pipe(
          map(Transition.toSimplePair),
          Dict.fromList,
        ),
      ),
    ),
  ),
  Dict.fromList,
)
destinations :: Machine pay ctx -> Set String
export destinations = pipe(
  eventMap,
  Dict.toList,
  chain(
    pipe(
      TuplePrelude.snd,
      Dict.toList,
      map(TuplePrelude.snd),
    ),
  ),
  Set.fromList,
)
isComplete :: Machine pay ctx -> Boolean
export isComplete = (mch) => pipe(
  destinations,
  Set.toList,
  List.all(hasState($, mch)),
)(mch)
findIncomplete :: Machine pay ctx -> Set String
export findIncomplete = (mch) => pipe(
  destinations,
  Set.filter(Fn.complement(hasState($, mch))),
)(mch)
firstState :: Machine pay ctx -> Maybe (State pay ctx)
export firstState = pipe(
  rawStates,
  List.first,
)
