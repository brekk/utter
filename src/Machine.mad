import type { Maybe } from "Maybe"
import type { Set } from "Set"

import type { State } from "@/State"

import Dict from "Dictionary"
import List from "List"
import Set from "Set"
import String from "String"

import Event from "@/Event"
import State from "@/State"
import Transition from "@/Transition"



export type Machine a b = Machine(String, List (State a b), Maybe (State a b))

// machine: "pen"
//   ↳ state: "extended"
//       ↳ event: "click" → "contracted"
//   ↳ state: "contracted"
//       ↳ event: "click" → "extended"

export create = (s, x) => Machine(s, x, List.first(x))

name :: Machine a b -> String
export name = where {
  Machine(n, _, _) =>
    n
}

states :: Machine a b -> List (State a b)
export states = where {
  Machine(_, sts, _) =>
    sts
}

stateSet :: Machine a b -> Set String
export stateSet = pipe(
  states,
  map(State.name),
  Set.fromList,
)

initialState :: Machine a b -> Maybe (State a b)
export initialState = where {
  Machine(_, _, m) =>
    m
}


// unique events that this machine responds to
events :: Machine a b -> Set String
export events = where {
  Machine(_, sts, _) =>
    pipe(
      chain(
        pipe(
          State.transitions,
          map(Transition.event),
          map(Event.name),
        ),
      ),
      Set.fromList,
    )(sts)
}

eventMap :: Machine a b -> Dictionary String (Dictionary String String)
export eventMap = where {
  Machine(_, sts, _) =>
    pipe(
      map(
        where {
          State.State(stateName, stateTransitions) =>
            #[
              stateName,
              pipe(
                map(
                  where {
                    Transition.Transition(Event.Event(eventName, payload), dest, _) =>
                      #[eventName, dest]
                  },
                ),
                Dict.fromList,
              )(stateTransitions),
            ]
        },
      ),
      Dict.fromList,
    )(sts)
}
