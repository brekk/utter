import type { Maybe } from "Maybe"
import type { Set } from "Set"

import type { State } from "@/State"

import Dict from "Dictionary"
import List from "List"
import Set from "Set"
import String from "String"

import Event from "@/Event"
import State from "@/State"
import Transition from "@/Transition"



export type Machine pay ctx = Machine(String, List (State pay ctx), Maybe (State pay ctx))
// machine: "pen"
//   ↳ state: "extended"
//       ↳ event: "click" → "contracted"
//   ↳ state: "contracted"
//       ↳ event: "click" → "extended"

export create = (s, x) => Machine(s, x, List.first(x))
name :: Machine pay ctx -> String
export name = where {
  Machine(n, _, _) =>
    n
}
states :: Machine pay ctx -> List (State pay ctx)
export states = where {
  Machine(_, sts, _) =>
    sts
}
stateSet :: Machine pay ctx -> Set String
export stateSet = pipe(
  states,
  map(State.name),
  Set.fromList,
)
initialState :: Machine pay ctx -> Maybe (State pay ctx)
export initialState = where {
  Machine(_, _, m) =>
    m
}
events :: Machine pay ctx -> Set Event
export events = pipe(
  states,
  chain(
    pipe(
      State.transitions,
      map(Transition.event),
    ),
  ),
  Set.fromList,
)
eventNames :: Machine pay ctx -> Set String
export eventNames = pipe(
  events,
)
eventMap :: Machine pay ctx -> Dictionary String (Dictionary String String)
export eventMap = where {
  Machine(_, sts, _) =>
    pipe(
      map(
        where {
          State.State(stateName, stateTransitions) =>
            #[
              stateName,
              pipe(
                map(where { Transition.Transition(ev, dest, _, _) => #[ev, dest] }),
                Dict.fromList,
              )(stateTransitions),
            ]
        },
      ),
      Dict.fromList,
    )(sts)
}
