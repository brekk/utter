import type { Maybe } from "Maybe"
import type { Set } from "Set"

import type { State } from "@/State"

import { lt } from "Compare"
import Dict from "Dictionary"
import Fn from "Function"
import List from "List"
import Maybe from "Maybe"
import Set from "Set"
import String from "String"
import TuplePrelude from "Tuple"

import Log from "@/Log"
import State from "@/State"
import Transition from "@/Transition"
import Tuple from "@/Tuple"



export type Machine pay ctx = Machine(String, List (State pay ctx), Maybe (State pay ctx))
create :: String -> List (State pay ctx) -> Machine pay ctx
export create = (s, x) => Machine(s, x, List.first(x))
name :: Machine pay ctx -> String
export name = where {
  Machine(n, _, _) =>
    n
}
rawStates :: Machine pay ctx -> List (State pay ctx)
export rawStates = where {
  Machine(_, sts, _) =>
    sts
}
states :: Machine pay ctx -> Set String
export states = pipe(
  rawStates,
  map(State.name),
  Set.fromList,
)
hasState :: String -> Machine pay ctx -> Boolean
export hasState = (x, mch) => pipe(
  states,
  Set.includes(x),
)(mch)
state :: Machine pay ctx -> Maybe (State pay ctx)
export state = where {
  Machine(_, _, m) =>
    m
}
isFinal :: (Show pay, Show ctx) => Machine pay ctx -> Boolean
export isFinal = Fn.ifElse(
  pipe(
    rawStates,
    List.length,
    lt(0),
  ),
  pipe(
    state,
    map(State.isFinal),
    Maybe.fromMaybe(false),
  ),
  Fn.always(true),
)
events :: Machine pay ctx -> Set String
export events = pipe(
  rawStates,
  chain(
    pipe(
      State.transitions,
      map(Transition.name),
    ),
  ),
  Set.fromList,
)
hasEvent :: String -> Machine pay ctx -> Boolean
export hasEvent = (ev, mch) => pipe(
  events,
  Set.includes(ev),
)(mch)
eventMap :: Machine pay ctx -> Dictionary String (Dictionary String String)
export eventMap = pipe(
  rawStates,
  map(
    pipe(
      State.toPair,
      Tuple.mapSnd(
        pipe(
          map(Transition.toSimplePair),
          Dict.fromList,
        ),
      ),
    ),
  ),
  Dict.fromList,
)
destinations :: Machine pay ctx -> Set String
export destinations = pipe(
  eventMap,
  Dict.toList,
  chain(
    pipe(
      TuplePrelude.snd,
      Dict.toList,
      map(TuplePrelude.snd),
    ),
  ),
  Set.fromList,
)
complete :: Machine pay ctx -> Boolean
export complete = (mch) => pipe(
  destinations,
  Set.toList,
  List.all(hasState($, mch)),
)(mch)
findIncomplete :: Machine pay ctx -> Set String
export findIncomplete = (mch) => pipe(
  destinations,
  Set.filter(Fn.complement(hasState($, mch))),
)(mch)
