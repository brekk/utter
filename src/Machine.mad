import type { Maybe } from "Maybe"

import type { State } from "@/State"

import Dict from "Dictionary"
import List from "List"
import { Just, Nothing, fromMaybe } from "Maybe"

import { ERRORS, ERROR_CODES } from "@/Error"
import { log, say } from "@/Log"



export type Machine pay context
  = Machine(String, List (State pay context), Maybe (State pay context))

export create = (n, sts) => Machine(n, sts, List.first(sts))

export name = where {
  Machine(a, _, _) =>
    a
}
export states = where {
  Machine(_, s, _) =>
    s
}
export initial = where {
  Machine(_, _, i) =>
    i
}
