import { caseN2, report } from "Study"

import Event from "@/Event"
import { create, createFinal, isFinal, name, nameMatches, transitions } from "@/State"
import Transition from "@/Transition"
import { FinalState, State } from "@/Types"



report(createFinal, "createFinal", [#["butts", FinalState("butts")]])
report(isFinal, "isFinal", [#[FinalState("butts"), true]])
report(caseN2(create), "create", [#[#["butts", []], FinalState("butts")]])
report(
  caseN2(nameMatches),
  "nameMatches",
  [#[#["hello", create("hello", [])], true], #[#["hello", create("goodbye", [])], false]],
)
ADD_TO_CART_SELF_EVENT = Transition.createBasic("add-to-cart", "cart")
report(
  transitions,
  "transitions",
  [
    #[State("cart", []), []],
    #[State("cart", [ADD_TO_CART_SELF_EVENT]), [ADD_TO_CART_SELF_EVENT]],
    #[FinalState("barf"), []],
  ],
)
