import { caseN2, report } from "Study"

import Event from "@/Event"
import { State, create, createFinal, name, nameMatches, transitions } from "@/State"
import Transition from "@/Transition"



report(createFinal, "createFinal", [#["butts", State("butts", [])]])
report(caseN2(create), "create", [#[#["butts", []], State("butts", [])]])
report(
  caseN2(nameMatches),
  "nameMatches",
  [#[#["hello", create("hello", [])], true], #[#["hello", create("goodbye", [])], false]],
)
ADD_TO_CART_SELF_EVENT = Transition.create("add-to-cart", "cart")
report(
  transitions,
  "transitions",
  [#[State("cart", []), []], #[State("cart", [ADD_TO_CART_SELF_EVENT]), [ADD_TO_CART_SELF_EVENT]]],
)
