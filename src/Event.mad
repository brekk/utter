import type { Maybe } from "Maybe"

import { Nothing } from "Maybe"
import String from "String"



export type EventKind = ImmediateEvent | UserEvent | AsyncEvent

export type Event = NullEvent | Event(String)

export create = Event

name :: Event -> String
export name = where {
  Event(n) =>
    n

  NullEvent =>
    "__NULLEVENT__"
}
