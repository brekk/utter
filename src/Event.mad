import type { Maybe } from "Maybe"

import { Nothing } from "Maybe"
import String from "String"



export type EventKind = ImmediateEvent | UserEvent | AsyncEvent

export type Event a = Event(String, Maybe a)

export create = Event($, Nothing)
export withPayload = Event

name :: Event a -> String
export name = where {
  Event(n, _) =>
    n
}

payload :: Event a -> Maybe a
export payload = where {
  Event(_, p) =>
    p
}
