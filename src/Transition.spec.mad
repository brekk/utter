import type { Guard, Transition, TransitionModifier } from "@/Transition"

import IO from "IO"
import { Just, Nothing } from "Maybe"

import { caseN2, caseN3, caseN4, report } from "Study"

import { Event } from "@/Event"
import {
  Guard,
  Transition,
  checkGuard,
  create,
  event,
  modifiers,
  target,
  withContext,
} from "@/Transition"



CLICK = Event("click")
HARNESS = {
  CLICK_NO_MOD: Transition(CLICK, "extended", Nothing),
  CLICK_WITH_GUARD: Transition(
    CLICK,
    "extended",
    Just({
      actions: [],
      reducers: [],
      guards: [
        Guard(
          (mCtx, ev, mPay) => where(#[mCtx, ev, mPay]) {
            #[Just(ctx), Event(e), Just(pay)] =>
              IO.pTrace("context and payload!", e == "click" && pay.message != "hey")

            #[_, Event(e), _] =>
              e == "click"

            _ =>
              false
          },
        ),
      ],
    }),
  ),
  CLICK_WITH_MULTIPLE_GUARDS: Transition(
    CLICK,
    "extended",
    Just({
      actions: [],
      reducers: [],
      guards: [
        Guard((_, _, _) => false),
        Guard(
          (mCtx, ev, mPay) => where(#[mCtx, ev, mPay]) {
            #[Just(ctx), Event(e), Just(pay)] =>
              false

            #[_, Event(e), _] =>
              false

            _ =>
              false
          },
        ),
      ],
    }),
  ),
}

report(caseN2(create), "create", [#[#["click", "extended"], HARNESS.CLICK_NO_MOD]])

report(target, "target", [#[HARNESS.CLICK_NO_MOD, "extended"]])

report(modifiers, "modifiers", [#[HARNESS.CLICK_NO_MOD, Nothing]])

report(
  caseN4(checkGuard),
  "checkGuard",
  [
    #[#[CLICK, Nothing, Nothing, HARNESS.CLICK_NO_MOD], true],
    #[
      #[
        Event("click"),
        Just({ message: "hey" }),
        Just({ context: "I AM CONTEXT" }),
        HARNESS.CLICK_WITH_GUARD,
      ],
      false,
    ],
    #[
      #[
        Event("click"),
        Just({ message: "I am a message that isn't just 'hey'" }),
        Just({ context: "I AM CONTEXT" }),
        HARNESS.CLICK_WITH_GUARD,
      ],
      true,
    ],
    #[
      #[
        Event("click"),
        Just({ message: "I am a message that isn't just 'hey'" }),
        Just({ context: "I AM CONTEXT" }),
        HARNESS.CLICK_WITH_MULTIPLE_GUARDS,
      ],
      false,
    ],
  ],
)
