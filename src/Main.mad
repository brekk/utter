import Dict from "Dictionary"
import { Left, Right } from "Either"
import IO from "IO"
import List from "List"
import { Just, Nothing, fromMaybe } from "Maybe"

import { interpret } from "@/Interpreter"
import { log } from "@/Log"
import Machine from "@/Machine"
import State from "@/State"
import Transition from "@/Transition"



STATES = { CONTRACTED: "contracted", EXTENDED: "extended" }


main = () => {
  contracted = State.create(STATES.CONTRACTED, [Transition.create("click", STATES.EXTENDED)])
  extended = State.create(STATES.EXTENDED, [Transition.create("click", STATES.CONTRACTED)])
  // IO.pTrace("transitions", #[contracted, extended])
  pen = Machine.create("pen", [contracted, extended])
  // IO.pTrace("PEN", pen)
  // IO.pTrace("Machine.events", Machine.events(pen))
  // IO.pTrace("Machine.eventMap", Machine.eventMap(pen))
  pipe(
    interpret(Nothing),
    where {
      Right(cmd) =>
        do {
          cmd.send("click")
          return {}
        }

      Left(why) =>
        do {
          IO.pTrace("FAILED", why)
        }
    },
  )(pen)
}
