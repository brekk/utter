import type { Guard } from "@/Types"

import Date from "Date"
import Dict from "Dictionary"
import { Left, Right } from "Either"
import IO from "IO"
import List from "List"
import { Just, Nothing, fromMaybe } from "Maybe"

import Closure from "@/Closure"
import Guard from "@/Guard"
import Interpreter from "@/Interpreter"
import Log from "@/Log"
import Machine from "@/Machine"
import State from "@/State"
import Transition from "@/Transition"



STATES = { CONTRACTED: "contracted", EXTENDED: "extended" }
ping = (ix) => pipe(
  Interpreter.state,
  map(State.name),
  (v) => where(v) {
    Just(r) =>
      Log.env.mainPen(show(Date.now()), r)

    _ =>
      Log.env.mainPen("invalid state", "check")
  },
  (_) => ix,
)(ix)
// v.count < 10 &&
main = () => {
  isClick = Guard.create((ev, _, _) => ev == "click")
  contracted = State.create(
    STATES.CONTRACTED,
    [Transition.createWithContext("click", STATES.EXTENDED, [], [isClick], [])],
  )
  extended = State.create(STATES.EXTENDED, [Transition.create("click", STATES.CONTRACTED)])
  // IO.pTrace("transitions", #[contracted, extended])
  pen = Machine.Machine("pen", [contracted, extended], Just(contracted))
  // IO.pTrace("PEN", pen)
  // IO.pTrace("Machine.events", Machine.events(pen))
  // IO.pTrace("Machine.eventMap", Machine.eventMap(pen))

  // map(
  //   (t) => Interpreter.checkTransitions(
  //     t,
  //     Interpreter.findEvent("click", Machine.events(pen)),
  //     Nothing,
  //     Nothing,
  //   ),
  // ),

  // Interpreter.interpret(Just({ count: 0 })),
  // pipe(
  //   Interpreter.interpret(Nothing),
  //   where {
  //     Right(Interpreter.Controller(state, run)) =>
  //       do {
  //         // IO.pTrace("SEND?!?", cmd)
  //         run(state, "click", Nothing)
  //         // IO.pTrace("smippppp", cmd.smipsmap("click", Nothing))
  //         return {}
  //       }
  //
  //     Left(why) =>
  //       do {
  //         IO.pTrace("FAILED", why)
  //         return {}
  //       }
  //   },
  // )(pen)
  pipe(
    Interpreter.create(Nothing),
    ping,
    Interpreter.send("click", Nothing),
    ping,
    Interpreter.send("click", Nothing),
    ping,
  )(pen)
}
