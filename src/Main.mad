import Dict from "Dictionary"
import IO from "IO"
import List from "List"
import { Just, Nothing, fromMaybe } from "Maybe"

import { machine, state, transition } from "@/Idea"
import { log } from "@/Log"



STATES = { CONTRACTED: "contracted", EXTENDED: "extended" }


main = () => {
  contracted = state(STATES.CONTRACTED, [transition("click", STATES.EXTENDED)])
  extended = state(STATES.EXTENDED, [transition("click", STATES.CONTRACTED)])
  // IO.pTrace("transitions", #[contracted, extended])
  pen = machine("pen", [contracted, extended])
  IO.pTrace("PEN", pen)
}
