import IO from "IO"
import { Just, Nothing } from "Maybe"
import StreamPrelude from "Stream"
import { assertEquals, test } from "Test"

import Event from "@/Event"
import Graph from "@/Graph"
import Guard from "@/Guard"
import Interpreter from "@/Interpreter"
import Log from "@/Log"
import Machine from "@/Machine"
import State from "@/State"
import Stream from "@/Stream"
import Transition from "@/Transition"
import { Action, Reducer } from "@/Types"



THE_LIMIT = 5
GUARD_THE_LIMIT = Guard.create(
  (ev, pay, mCtx) => {
    return ev
      == "again"
      && where(#[mCtx, pay]) {
        #[Just(ctx), Just(_pay)] =>
          do {
            count = ctx.count + _pay.count
            return count <= THE_LIMIT
          }

        #[Just(_ctx), Nothing] =>
          _ctx.count <= THE_LIMIT

        #[Nothing, Just(_pay)] =>
          _pay.count <= THE_LIMIT

        _ =>
          false
      }
  },
)
INCREASE_THE_LIMIT = Reducer(
  (ev, pay, con) => where(#[pay, con]) {
    #[Just(payload), Just(ctx)] =>
      Just({ ...ctx, count: ctx.count + payload.count })

    _ =>
      con
  },
)
ANNOUNCE = Action((ev, pay, ctx) => { IO.pTrace(">>>", #[ev, pay, ctx]) })
ONLY = State.create(
  "only",
  [Transition.create("again", "only", [ANNOUNCE], [GUARD_THE_LIMIT], [INCREASE_THE_LIMIT])],
)
machine = Machine.create("uno", [ONLY])
machine2 = Machine.create(
  "immediate",
  [
    State.create("idle", [Transition.createRaw("fetch", "loading")]),
    State.create("loading", [Transition.createRaw("done", "validate")]),
    State.create(
      "validate",
      [
        Transition.createImmediate(
          "loaded",
          [],
          [],
          [
            Reducer(
              (ev, pay, con) => where(con) {
                Just(ctx) =>
                  IO.pTrace("YOYOYO", Just({ ...ctx, count: 4, hooray: true }))

                _ =>
                  con
              },
            ),
          ],
        ),
        Transition.createImmediate("error", [], [Guard.invert(GUARD_THE_LIMIT)], []),
      ],
    ),
    State.createFinal("loaded"),
    State.createFinal("error"),
  ],
)
