import IO from "IO"
import { Just, Nothing } from "Maybe"
import StreamPrelude from "Stream"
import { assertEquals, test } from "Test"

import Action from "@/Action"
import Interpreter from "@/Controller"
import Event from "@/Event"
import Graph from "@/Graph"
import Guard from "@/Guard"
import Log from "@/Log"
import Machine from "@/Machine"
import Reducer from "@/Reducer"
import State from "@/State"
import Stream from "@/Stream"
import Transition from "@/Transition"



shield = Guard.herald(Log.env.guard)
THE_LIMIT = 5
GUARD_THE_LIMIT = Guard.create(
  (ev, pay, mCtx) => {
    return Log
      .env
      .main(
        "EV: " ++ ev,
        where(#[mCtx, pay]) {
          #[Just(ctx), Just(_pay)] =>
            do {
              count = ctx.count + _pay.count
              return count <= THE_LIMIT
            }

          #[Just(_ctx), Nothing] =>
            _ctx.count <= THE_LIMIT

          #[Nothing, Just(_pay)] =>
            _pay.count <= THE_LIMIT

          _ =>
            false
        },
      )
  },
)
INCREASE_THE_LIMIT = Reducer.create(
  (ev, pay, con) => where(#[pay, con]) {
    #[Just(payload), Just(ctx)] =>
      Just({ ...ctx, count: ctx.count + payload.count })

    _ =>
      con
  },
)
ANNOUNCE = Action.create((ev, pay, ctx) => { IO.pTrace(">>>", #[ev, pay, ctx]) })
ONLY = State.create(
  "only",
  [Transition.create("again", "only", [ANNOUNCE, GUARD_THE_LIMIT, INCREASE_THE_LIMIT])],
)
machine = Machine.create("uno", [ONLY])
formMachine = Machine.create(
  "immediate",
  [
    State.create("idle", [Transition.via("fetch", "loading")]),
    State.create("loading", [Transition.via("done", "validate")]),
    State.create(
      "validate",
      [
        Transition.createImmediate("loaded", [ANNOUNCE, GUARD_THE_LIMIT]),
        Transition.createImmediate("error", [ANNOUNCE, Guard.invert(GUARD_THE_LIMIT)]),
      ],
    ),
    State.createFinal("loaded"),
    State.createFinal("error"),
  ],
)
makePingPong = () => {
  ONE = State.create("one", [Transition.via("ping", "two")])
  TWO = State.create("two", [Transition.via("pong", "one")])
  m = Machine.create("ping-pong", [ONE, TWO])
  return { machine: m, TWO, ONE }
}
