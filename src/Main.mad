import Dict from "Dictionary"
import IO from "IO"
import List from "List"
import { Just, Nothing, fromMaybe } from "Maybe"

import Blueprint from "@/Blueprint"
import Sketch from "@/Blueprint/Sketch"
import Event from "@/Event"
import Interpreter from "@/Interpreter"
import { log } from "@/Log"
import Machine from "@/Machine"
import State from "@/State"
import Transition from "@/Transition"



STATES = { CONTRACTED: "contracted", EXTENDED: "extended" }

main = () => {
  extended = State.create(
    STATES.EXTENDED,
    [Transition.Route(Event.create("click"), STATES.CONTRACTED)],
  )

  contracted = State.create(
    STATES.CONTRACTED,
    [Transition.Route(Event.create("click"), STATES.EXTENDED)],
  )
  IO.pTrace("STATES?", #[extended, contracted])
  penMachine = Machine.create("pen", [extended, contracted])
  // (x) => Blueprint.fromDraft(Machine.initial(x), x)
  // Machine.states,
  // IO.pTrace("PEN MACHINE STATES?"),
  // Sketch.fromStates,
  // IO.pTrace("STATO STATUS"),
  pipe(
    IO.pTrace("PEN MACHINE?"),
    Blueprint.fromMachine,
    IO.pTrace("THE MACHINE"),
  )(penMachine)
}

