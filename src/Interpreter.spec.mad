import { Just, Nothing } from "Maybe"
import { assertEquals, test } from "Test"

import { caseN2, caseN3, caseN4, report } from "Study"

import { Guard } from "@/Guard"
import { checkTransitions, findEvent } from "@/Interpreter"
import Machine from "@/Machine"
import State from "@/State"
import Transition from "@/Transition"



STATES = { CONTRACTED: "contracted", EXTENDED: "extended" }
isClickNoContext = Guard((_, ev, _) => ev == "click")
isClickUnderTen = Guard(
  (mCtx, ev, mPay) => where(#[mCtx, ev, mPay]) {
    #[Just(ctx), name, Just(pay)] =>
      name == "click" && ctx.count <= 10 && pay.message != ""

    _ =>
      false
  },
)
SIMPLE_EXTENDED = State.create(STATES.EXTENDED, [Transition.create("click", STATES.CONTRACTED)])
SIMPLE_CONTRACTED = State.create(STATES.CONTRACTED, [Transition.create("click", STATES.EXTENDED)])
TRANSITION_TO_EXTENDED = Transition.createWithContext(
  "click",
  STATES.EXTENDED,
  [],
  [isClickUnderTen],
  [],
)
TRANSITION_TO_CONTRACTED = Transition.createWithContext(
  "click",
  STATES.CONTRACTED,
  [],
  [isClickUnderTen],
  [],
)
COMPLEX_EXTENDED = State.create(STATES.CONTRACTED, [TRANSITION_TO_EXTENDED])
COMPLEX_CONTRACTED = State.create(STATES.EXTENDED, [TRANSITION_TO_CONTRACTED])
PEN = Machine.Machine("pen", [SIMPLE_CONTRACTED, SIMPLE_EXTENDED], Just(SIMPLE_CONTRACTED))
COMPLEX_PEN = Machine.Machine(
  "pen",
  [COMPLEX_CONTRACTED, COMPLEX_EXTENDED],
  Just(COMPLEX_CONTRACTED),
)
report(findEvent("click"), "findEvent (click)", [#[["not a click", "click"], Just("click")]])
