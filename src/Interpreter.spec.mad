test(
  "checkTransitions",
  () => {
    // happy path
    out = checkTransitions(
      [TRANSITION_TO_EXTENDED],
      Just("click"),
      Just({ count: 0 }),
      Just({ message: "hey" }),
    )
    assertEquals(out, true)
    // guard should fail
    shouldFail = checkTransitions(
      [TRANSITION_TO_EXTENDED],
      Just("click"),
      Just({ count: 100 }),
      Just({ message: "hey" }),
    )
    return assertEquals(shouldFail, false)
  },
)

