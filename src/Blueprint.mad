import type { Either } from "Either"
import type { Maybe } from "Maybe"

import type { Machine } from "@/Machine"
import type { State } from "@/State"
import type { Transition, Transitions } from "@/Transition"

import Dict from "Dictionary"
import { Left, Right } from "Either"
import { Just, Nothing, fromMaybe } from "Maybe"

import Draft from "@/Blueprint/Draft"
import { log } from "@/Log"
import Machine from "@/Machine"
import State from "@/State"



export type Blueprint a b c
  = Blueprint(
    List String,
    String -> Boolean,
    String -> Boolean,
    Dictionary (State String) (Transitions String b c),
  )

import IO from "IO"



// chain(Dict.get($, states)),
// IO.pTrace(""),
// fromMaybe([]),
// Blueprint a b c
fromMachine :: Machine String -> Either String String
export fromMachine = (m) => pipe(
  Draft.fromMachine,
  where {
    Draft.Draft(states, stateSet, eventSet) =>
      do {
        IO.pTrace("STATES?!?", states)
        destinations = pipe(
          State.fromDict,
          map(State.id),
        )

        IO.pTrace("HUH", destinations(states))

        return Left("temp")
      }

    Draft.InvalidDraft(why) =>
      Left(why)
  },
)(m)
