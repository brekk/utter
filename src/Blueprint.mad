import type { Either } from "Either"
import type { Maybe } from "Maybe"

import type { Machine } from "@/Machine"
import type { State } from "@/State"
import type { Transition, Transitions } from "@/Transition"

import Dict from "Dictionary"
import { Left, Right } from "Either"
import { Just, Nothing, fromMaybe } from "Maybe"

import Draft from "@/Blueprint/Draft"
import { log } from "@/Log"
import Machine from "@/Machine"
import State from "@/State"
import Transition from "@/Transition"



export type Blueprint a b c = Blueprint(List String, Dictionary (State b c) (Transitions b c))

import IO from "IO"



destinations = (t) => pipe(
  State.fromDict,
  chain(
    pipe(
      State.id,
      Dict.get($, t),
      fromMaybe([]),
      map(Transition.destination),
    ),
  ),
)(t)

// IO.pTrace(""),
// fromMaybe([]),
// Blueprint a b c
fromMachine :: Machine String String -> Either String (Blueprint a pay ctx)
export fromMachine = (m) => pipe(
  Draft.fromMachine,
  where {
    Draft.Draft(transitions, stateSet, eventSet) =>
      do {
        IO.pTrace("STATES?!?", transitions)


        IO.pTrace("HUH", destinations(transitions))

        return Right(Blueprint(destinations(transitions), stateSet, eventSet))
        // return Left("shit")
      }

    Draft.InvalidDraft(why) =>
      Left(why)
  },
)(m)
