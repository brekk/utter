import type { Machine } from "@/Machine"

import Dict from "Dictionary"
import { Just, Nothing } from "Maybe"
import Set from "Set"

import { caseN2, report } from "Study"

import { Event } from "@/Event"
import {
  Machine,
  create,
  eventMap,
  eventNames,
  events,
  initialState,
  name,
  stateSet,
  states,
} from "@/Machine"
import State from "@/State"
import Transition from "@/Transition"



report(caseN2(create), "create", [#[#["test", []], Machine("test", [], Nothing)]])

report(name, "name", [#[create("test", []), "test"]])

report(
  states,
  "states",
  [#[create("test", [State.create("passing", [])]), [State.create("passing", [])]]],
)

report(
  stateSet,
  "stateSet",
  [
    #[
      create("test", [State.create("passing", []), State.create("failing", [])]),
      Set.fromList(["passing", "failing"]),
    ],
  ],
)

report(
  initialState,
  "initialState",
  [
    #[
      create("test", [State.create("passing", []), State.create("failing", [])]),
      Just(State.create("passing", [])),
    ],
  ],
)

failMachine = create(
  "test",
  [
    State.create("passing", [Transition.create("fails", "failing")]),
    State.create("failing", [Transition.create("fails", "passing")]),
  ],
)

report(
  events,
  "events",
  [
    #[failMachine, Set.fromList([Event("fails")])],
    #[create("test", [State.create("passing", []), State.create("failing", [])]), Set.empty],
  ],
)

report(eventNames, "eventNames", [#[failMachine, Set.fromList(["fails"])]])


report(
  eventMap,
  "eventMap",
  [#[failMachine, {{ "failing": {{ "fails": "passing" }}, "passing": {{ "fails": "failing" }} }}]],
)
