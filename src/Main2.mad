import IO from "IO"
import { Just, Nothing } from "Maybe"
import StreamPrelude from "Stream"
import { assertEquals, test } from "Test"

import Event from "@/Event"
import Graph from "@/Graph"
import Guard from "@/Guard"
import Interpreter from "@/Interpreter"
import Log from "@/Log"
import Machine from "@/Machine"
import State from "@/State"
import Stream from "@/Stream"
import Transition from "@/Transition"
import { Action, ActionController, Reducer } from "@/Types"



THE_LIMIT = 5
GUARD_THE_LIMIT = Guard.create(
  (ev, ctx, pay) => {
    return ev
      == "again"
      && where(#[ctx, pay]) {
        #[Just(_ctx), Just(_pay)] =>
          do {
            count = _ctx.count + _pay.count
            return count <= THE_LIMIT
          }

        #[Just(_ctx), Nothing] =>
          _ctx.count <= THE_LIMIT

        _ =>
          false
      }
  },
)
INCREASE_THE_LIMIT = Reducer(
  (ev, pay, con) => where(#[pay, con]) {
    #[Just(payload), Just(ctx)] =>
      Just({ ...ctx, count: ctx.count + payload.count })

    _ =>
      con
  },
)
ANNOUNCE = Action((ev, pay, ctx) => { IO.pTrace(">>>", #[ev, pay, ctx]) })
ONLY = State.create(
  "only",
  [
    Transition.createWithContext(
      "again",
      "only",
      [ANNOUNCE],
      [GUARD_THE_LIMIT],
      [INCREASE_THE_LIMIT],
      [],
    ),
  ],
)
machine = Machine.create("uno", [ONLY])
EVENTUALLY_GO_TO_THE_END = ActionController(
  (ctrl, ev, pay, mCtx) => where(#[pay, mCtx]) {
    #[Just(_pay), Just(ctx)] =>
      do {
        IO.pTrace("ACTION CONTROLLER", #[ev, pay, mCtx])
        return if (_pay.count + ctx.count > THE_LIMIT) {
          Interpreter.send("stop", Nothing, ctrl)
        } else {
          ctrl
        }
      }

    _ =>
      ctrl
  },
)
machine2 = Machine.create(
  "duo",
  [
    State.create(
      "only",
      [
        Transition.createVerboseWithContext(
          "again-loop",
          "again",
          "only",
          [ANNOUNCE],
          [GUARD_THE_LIMIT],
          [INCREASE_THE_LIMIT],
          [EVENTUALLY_GO_TO_THE_END],
        ),
        Transition.createVerboseWithContext(
          "again-inter",
          "again",
          "intermediate",
          [ANNOUNCE],
          [Guard.invert(GUARD_THE_LIMIT)],
          [],
          [],
        ),
      ],
    ),
    State.create("intermediate", [Transition.createComplex("stop", "end", [ANNOUNCE], [], [], [])]),
    State.createFinal("end"),
  ],
)
