import IO from "IO"
import { Just, Nothing } from "Maybe"
import { assertEquals, test } from "Test"

import { Action } from "@/Action"
import Event from "@/Event"
import Guard from "@/Guard"
import Interpreter from "@/Interpreter"
import Machine from "@/Machine"
import { ActionReducer } from "@/Reducer"
import State from "@/State"
import Transition from "@/Transition"



THE_LIMIT = 5
GUARD_THE_LIMIT = Guard.create(
  (ev, ctx, pay) => {
    IO.pTrace("EVENT: " ++ ev, #[ctx, pay])
    return ev
      == "again"
      && IO.pTrace(
        "MATCHED?",
        where(#[ctx, pay]) {
          #[Just(_ctx), Just(_pay)] =>
            do {
              count = _ctx.count + _pay.count
              IO.pTrace(
                ">?>? " ++ show(_ctx.count) ++ " + " ++ show(_pay.count) ++ " <<!<",
                #[count, THE_LIMIT],
              )
              return count <= THE_LIMIT
            }

          #[Just(_ctx), Nothing] =>
            _ctx.count <= THE_LIMIT

          _ =>
            false
        },
      )
  },
)
INCREASE_THE_LIMIT = ActionReducer(
  (ev, pay, con) => where(#[pay, con]) {
    #[Just(payload), Just(ctx)] =>
      do {
        IO.pTrace("COUNTING", #[ctx, payload])
        cty = { ...ctx, count: ctx.count + payload.count }
        return Just(cty)
      }

    _ =>
      con
  },
)
main = () => {
  ONLY = State.create(
    "only",
    [Transition.createWithContext("again", "only", [], [GUARD_THE_LIMIT], [INCREASE_THE_LIMIT])],
  )
  machine = Machine.create("uno", [ONLY])
  DATA = { count: 0 }
  service = Interpreter.create(Just(DATA), machine)
  IO.pTrace("CONTEXT 1", Interpreter.context(service))
  service2 = Interpreter.send("again", Just({ count: 1 }), service)
  IO.pTrace("CONTEXT 2", Interpreter.context(service2))
  service3 = Interpreter.send("again", Just({ count: 1 }), service2)
  IO.pTrace("CONTEXT 3", Interpreter.context(service3))
  // shouldn't run because it would exceed THE_LIMIT
  serviceNo = Interpreter.send("again", Just({ count: 10 }), service3)
  IO.pTrace("CONTEXT 4", Interpreter.context(serviceNo))
}
